{
  "sourceFormat": "oceanleo.game-document.v1",
  "source": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<meta name=\"description\" content=\"一款先规划后执行的路径小游戏：画出经过三个取件点并回到交货口的路线，油量是唯一的难度。\">\n<title>夜班配送</title>\n<style>\nhtml, body { margin: 0; padding: 0; height: 100%; background: #101A2B; overflow: hidden; }\nbody { touch-action: none; -webkit-user-select: none; user-select: none; }\n#stage { display: block; width: 100%; height: 100%; }\n#fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\n  font: 16px/1.7 system-ui, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  color: #fff; opacity: .75; text-align: center; padding: 2rem; }\n</style>\n</head>\n<body>\n<canvas id=\"stage\" role=\"img\" aria-label=\"一款先规划后执行的路径小游戏：画出经过三个取件点并回到交货口的路线，油量是唯一的难度。\"></canvas>\n<noscript><div id=\"fallback\">这是一款需要 JavaScript 才能运行的小游戏：一款先规划后执行的路径小游戏：画出经过三个取件点并回到交货口的路线，油量是唯一的难度。</div></noscript>\n<script>\n// 夜班配送 —— 玩法风格「一次成行」（one-shot-route）\n// 循环：看清地形与油量 → 在盘面上画出整条路线 → 按下出发 → 看着它一步一步走完并当场结算 →\n//      拿这次的结果重画一条更省的路，回到看地形。\n// 难度只来自一个能数出来的预算（油）。执行段一个输入都不收，随机零处，\n// 地形与最短步数全部印在屏上——唯一稀缺的东西是油。\nvar bundle = (function () {\n  \"use strict\";\n\n  // '#' 墙 · '.' 可走 · 'S' 车库（起点）· 'A''B''C' 三个取件点 · 'X' 交货口\n  var MAP = [\n    \"###########\",\n    \"#S..#...A.#\",\n    \"#.#.#.###.#\",\n    \"#.#...#.B.#\",\n    \"#.###.#.#.#\",\n    \"#C....#..X#\",\n    \"###########\"\n  ];\n  var COLS = MAP[0].length, ROWS = MAP.length;\n  var FUEL = 60;          // 一夜的油，按格算。跑掉的就没了，跑得再漂亮也不退。\n  var STEP_FRAMES = 7;    // 执行段每格停几帧：慢到看得清每一步落在哪\n  var SETTLE_MS = 1100;\n\n  // 夜色 + 建筑灰蓝 + 一支只属于「我画的路线」的荧光绿 + 一支只属于「还没取的件」的琥珀\n  var NIGHT = [16, 26, 43], WALL = [43, 58, 85], ROUTE = [87, 242, 165], PICK = [255, 179, 71];\n  function rgba(c, a) { return \"rgba(\" + c[0] + \",\" + c[1] + \",\" + c[2] + \",\" + a + \")\"; }\n\n  var W = 0, H = 0, S = null, GRID = null, START = 0, EXIT = 0, PICKS = null, BEST = 0;\n\n  function finite(v, f) { return (typeof v === \"number\" && isFinite(v)) ? v : f; }\n  var idx = function (c, r) { return r * COLS + c; };\n  var cx = function (i) { return i % COLS; };\n  var cy = function (i) { return Math.floor(i / COLS); };\n\n  function bake() {\n    var r, c, ch;\n    GRID = [];\n    PICKS = [];\n    for (r = 0; r < ROWS; r++) {\n      for (c = 0; c < COLS; c++) {\n        ch = MAP[r].charAt(c);\n        GRID.push(ch === \"#\" ? 0 : 1);\n        if (ch === \"S\") START = idx(c, r);\n        else if (ch === \"X\") EXIT = idx(c, r);\n        else if (ch === \"A\" || ch === \"B\" || ch === \"C\") PICKS.push(idx(c, r));\n      }\n    }\n    BEST = bestRoute();\n  }\n\n  /** 从一个格子出发的逐格步数（广度优先，只走可走格）。 */\n  function dist(from) {\n    var d = [], i;\n    for (i = 0; i < ROWS * COLS; i++) d.push(-1);\n    d[from] = 0;\n    var q = [from], head = 0;\n    while (head < q.length) {\n      var cur = q[head++];\n      var x = cx(cur), y = cy(cur);\n      var nb = [];\n      if (x > 0) nb.push(idx(x - 1, y));\n      if (x < COLS - 1) nb.push(idx(x + 1, y));\n      if (y > 0) nb.push(idx(x, y - 1));\n      if (y < ROWS - 1) nb.push(idx(x, y + 1));\n      for (i = 0; i < nb.length; i++) {\n        if (GRID[nb[i]] && d[nb[i]] < 0) { d[nb[i]] = d[cur] + 1; q.push(nb[i]); }\n      }\n    }\n    return d;\n  }\n\n  /** 三个取件点的全部先后次序里最省的那条：这个数印在屏上，玩家看得见。 */\n  function bestRoute() {\n    var order = [[0, 1, 2], [0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1], [2, 1, 0]];\n    var dS = dist(START), dP = [dist(PICKS[0]), dist(PICKS[1]), dist(PICKS[2])];\n    var best = -1, k, o, n;\n    for (k = 0; k < order.length; k++) {\n      o = order[k];\n      n = dS[PICKS[o[0]]] + dP[o[0]][PICKS[o[1]]] + dP[o[1]][PICKS[o[2]]] + dP[o[2]][EXIT];\n      if (best < 0 || n < best) best = n;\n    }\n    return best;\n  }\n\n  function fresh(fuel, trip) {\n    S = {\n      phase: \"plan\",              // plan 规划 / run 执行 / settle 结算\n      route: [START], fuel: finite(fuel, FUEL), trip: finite(trip, 1),\n      at: 0, tick: 0, got: [false, false, false],\n      settle: 0, why: \"\", lastRun: null, over: null, overAge: 0, acts: 0\n    };\n    return S;\n  }\n\n  function layout() {\n    var bar = Math.max(52, Math.min(H * 0.12, 84));\n    var foot = Math.max(44, Math.min(H * 0.10, 68));\n    var pad = Math.max(12, Math.min(W, H) * 0.024);\n    var side = Math.min(W * 0.26, 240);\n    var freeW = W - side - pad * 3;\n    var freeH = H - bar - foot - pad * 2;\n    var tile = Math.floor(Math.min(freeW / COLS, freeH / ROWS));\n    return {\n      bar: bar, foot: foot, pad: pad, tile: tile, side: side,\n      ox: pad + Math.max(0, (freeW - tile * COLS) / 2),\n      oy: bar + pad + Math.max(0, (freeH - tile * ROWS) / 2),\n      sideX: W - side - pad, footTop: H - foot\n    };\n  }\n\n  function actionBoxes() {\n    var L = layout();\n    var h = Math.max(30, L.foot * 0.62);\n    var gap = Math.max(8, L.pad * 0.55);\n    var launchW = Math.max(82, Math.min(118, W * 0.14));\n    var undoW = Math.max(70, Math.min(98, W * 0.11));\n    var y = L.footTop + (L.foot - h) / 2;\n    var launch = { x: W - L.pad - launchW, y: y, w: launchW, h: h };\n    return {\n      launch: launch,\n      undo: { x: launch.x - gap - undoW, y: y, w: undoW, h: h }\n    };\n  }\n\n  function inside(x, y, box) {\n    return x >= box.x && x <= box.x + box.w && y >= box.y && y <= box.y + box.h;\n  }\n\n  function tileAt(x, y) {\n    var L = layout();\n    var c = Math.floor((x - L.ox) / L.tile), r = Math.floor((y - L.oy) / L.tile);\n    if (r < 0 || r >= ROWS || c < 0 || c >= COLS) return -1;\n    return idx(c, r);\n  }\n\n  function adjacent(a, b) {\n    return Math.abs(cx(a) - cx(b)) + Math.abs(cy(a) - cy(b)) === 1;\n  }\n\n  function extend(i) {\n    if (i < 0 || !GRID[i]) return;\n    var head = S.route[S.route.length - 1];\n    if (!adjacent(head, i)) return;\n    if (S.route.length - 1 >= S.fuel) return;      // 画不出油量以外的路线\n    S.route.push(i);\n    S.acts++;\n  }\n\n  function undo() {\n    if (S.route.length > 1) { S.route.pop(); S.acts++; }\n  }\n\n  function launch() {\n    if (S.route.length < 2) return;\n    S.phase = \"run\";\n    S.at = 0; S.tick = 0;\n    S.got = [false, false, false];\n    S.acts++;\n  }\n\n  function finishRun() {\n    var steps = S.route.length - 1;\n    var all = S.got[0] && S.got[1] && S.got[2];\n    var here = S.route[S.route.length - 1];\n    S.fuel -= steps;\n    S.lastRun = { steps: steps, got: (S.got[0] ? 1 : 0) + (S.got[1] ? 1 : 0) + (S.got[2] ? 1 : 0), atExit: here === EXIT };\n    if (all && here === EXIT) {\n      S.over = \"win\"; S.overAge = 0; S.why = \"三件全送到，回到了交货口\";\n      S.phase = \"settle\"; S.settle = 0;\n      return;\n    }\n    S.why = !all\n      ? \"还差 \" + (3 - S.lastRun.got) + \" 件没取\"\n      : \"件取齐了，但没停在交货口\";\n    S.phase = \"settle\";\n    S.settle = 0;\n  }\n\n  function afterSettle() {\n    if (S.over) return;\n    if (S.fuel < BEST) { S.over = \"lose\"; S.overAge = 0; S.why = \"油不够跑完最短的那条路了\"; return; }\n    S.trip++;\n    S.route = [START];\n    S.phase = \"plan\";\n  }\n\n  function pixel(g, px, weight) {\n    g.font = (weight ? weight + \" \" : \"\") + Math.round(px) +\n      \"px 'Noto Sans CJK SC', ui-monospace, 'PingFang SC', monospace\";\n  }\n\n  return {\n    title: \"夜班配送\",\n\n    setup: function (env) {\n      W = finite(env && env.width, 900);\n      H = finite(env && env.height, 620);\n      bake();\n      fresh(FUEL, 1);\n    },\n\n    resize: function (w, h) { W = finite(w, W); H = finite(h, H); },\n\n    pointer: function (x, y, phase) {\n      if (phase !== \"down\") return;\n      if (S.over) { if (S.overAge > 420) fresh(FUEL, 1); return; }\n      if (S.phase !== \"plan\") return;             // 执行段不收任何输入\n      x = finite(x, -1); y = finite(y, -1);\n      var buttons = actionBoxes();\n      if (inside(x, y, buttons.launch)) { launch(); return; }\n      if (inside(x, y, buttons.undo)) { undo(); return; }\n      extend(tileAt(x, y));\n    },\n\n    key: function (code, phase) {\n      if (phase !== \"down\") return;\n      if (S.over) {\n        if (code === \"Space\" || code === \"Enter\" || code === \" \") fresh(FUEL, 1);\n        return;\n      }\n      if (S.phase !== \"plan\") return;\n      if (code === \"Enter\" || code === \"Space\" || code === \" \") { launch(); return; }\n      if (code === \"KeyZ\" || code === \"Backspace\") { undo(); return; }\n      var head = S.route[S.route.length - 1];\n      var x = cx(head), y = cy(head);\n      if (code === \"ArrowLeft\") extend(idx(Math.max(0, x - 1), y));\n      else if (code === \"ArrowRight\") extend(idx(Math.min(COLS - 1, x + 1), y));\n      else if (code === \"ArrowUp\") extend(idx(x, Math.max(0, y - 1)));\n      else if (code === \"ArrowDown\") extend(idx(x, Math.min(ROWS - 1, y + 1)));\n    },\n\n    update: function (dt) {\n      dt = finite(dt, 16.67);\n      if (S.over) { S.overAge += dt; if (S.phase === \"settle\") S.settle += dt; return; }\n      if (S.phase === \"run\") {\n        S.tick++;\n        if (S.tick >= STEP_FRAMES) {\n          S.tick = 0;\n          S.at++;\n          var here = S.route[S.at];\n          for (var k = 0; k < PICKS.length; k++) if (here === PICKS[k]) S.got[k] = true;\n          if (S.at >= S.route.length - 1) finishRun();\n        }\n        return;\n      }\n      if (S.phase === \"settle\") {\n        S.settle += dt;\n        if (S.settle >= SETTLE_MS) afterSettle();\n      }\n    },\n\n    draw: function (g) {\n      var L = layout(), i, k, x, y;\n\n      g.fillStyle = rgba(NIGHT, 1);\n      g.fillRect(0, 0, W, H);\n\n      // 地形：墙是实块，可走格只留一个暗点，像素块不描边\n      for (i = 0; i < ROWS * COLS; i++) {\n        x = L.ox + cx(i) * L.tile;\n        y = L.oy + cy(i) * L.tile;\n        if (!GRID[i]) {\n          g.globalAlpha = 1;\n          g.fillStyle = rgba(WALL, 1);\n          g.fillRect(x, y, L.tile, L.tile);\n        } else {\n          g.globalAlpha = 0.35;\n          g.fillStyle = rgba(WALL, 1);\n          g.fillRect(x + L.tile * 0.46, y + L.tile * 0.46, Math.max(2, L.tile * 0.08), Math.max(2, L.tile * 0.08));\n        }\n      }\n      g.globalAlpha = 1;\n\n      // 已画的路线：一格一块，永不淡出（退回上一个岔口重想是主要动作）\n      for (i = 1; i < S.route.length; i++) {\n        x = L.ox + cx(S.route[i]) * L.tile;\n        y = L.oy + cy(S.route[i]) * L.tile;\n        g.globalAlpha = S.phase === \"plan\" ? 0.42 : 0.24;\n        g.fillStyle = rgba(ROUTE, 1);\n        g.fillRect(x + L.tile * 0.22, y + L.tile * 0.22, L.tile * 0.56, L.tile * 0.56);\n      }\n      g.globalAlpha = 1;\n\n      // 起点与交货口\n      x = L.ox + cx(START) * L.tile; y = L.oy + cy(START) * L.tile;\n      g.globalAlpha = 0.85;\n      g.strokeStyle = rgba(ROUTE, 1);\n      g.lineWidth = Math.max(2, L.tile * 0.09);\n      g.strokeRect(x + 3, y + 3, L.tile - 6, L.tile - 6);\n      x = L.ox + cx(EXIT) * L.tile; y = L.oy + cy(EXIT) * L.tile;\n      g.strokeStyle = rgba(PICK, 1);\n      g.strokeRect(x + 3, y + 3, L.tile - 6, L.tile - 6);\n      g.globalAlpha = 1;\n\n      // 取件点：还没取的是琥珀实块，取到手之后换成路线色的小块 —— 屏上亮着几个就是进度\n      for (k = 0; k < PICKS.length; k++) {\n        x = L.ox + cx(PICKS[k]) * L.tile;\n        y = L.oy + cy(PICKS[k]) * L.tile;\n        var done = S.got[k];\n        g.globalAlpha = done ? 0.55 : 0.95;\n        g.fillStyle = rgba(done ? ROUTE : PICK, 1);\n        var m = done ? L.tile * 0.34 : L.tile * 0.22;\n        g.fillRect(x + m, y + m, L.tile - m * 2, L.tile - m * 2);\n      }\n      g.globalAlpha = 1;\n\n      // 执行段：车子就是路线色的一块，只是它在动\n      if (S.phase === \"run\" || S.phase === \"settle\") {\n        var at = S.route[Math.min(S.at, S.route.length - 1)];\n        x = L.ox + cx(at) * L.tile; y = L.oy + cy(at) * L.tile;\n        g.fillStyle = rgba(ROUTE, 1);\n        g.fillRect(x + L.tile * 0.12, y + L.tile * 0.12, L.tile * 0.76, L.tile * 0.76);\n      }\n\n      // 规划段的笔头：下一步可以落在哪，四邻高亮\n      if (S.phase === \"plan\" && !S.over) {\n        var head = S.route[S.route.length - 1];\n        var hx = cx(head), hy = cy(head);\n        var nb = [idx(hx - 1, hy), idx(hx + 1, hy), idx(hx, hy - 1), idx(hx, hy + 1)];\n        for (i = 0; i < nb.length; i++) {\n          if (nb[i] < 0 || nb[i] >= ROWS * COLS || !GRID[nb[i]]) continue;\n          if (Math.abs(cx(nb[i]) - hx) + Math.abs(cy(nb[i]) - hy) !== 1) continue;\n          x = L.ox + cx(nb[i]) * L.tile; y = L.oy + cy(nb[i]) * L.tile;\n          g.globalAlpha = 0.30;\n          g.strokeStyle = rgba(ROUTE, 1);\n          g.lineWidth = Math.max(1.5, L.tile * 0.05);\n          g.strokeRect(x + 4, y + 4, L.tile - 8, L.tile - 8);\n        }\n        g.globalAlpha = 0.9;\n        x = L.ox + cx(head) * L.tile; y = L.oy + cy(head) * L.tile;\n        g.fillStyle = rgba(ROUTE, 1);\n        g.fillRect(x + L.tile * 0.3, y + L.tile * 0.3, L.tile * 0.4, L.tile * 0.4);\n        g.globalAlpha = 1;\n      }\n      g.lineWidth = 1;\n    },\n\n    hud: function (g) {\n      var L = layout(), i;\n\n      // 顶栏\n      g.globalAlpha = 0.5;\n      g.fillStyle = rgba(WALL, 1);\n      g.fillRect(0, 0, W, L.bar);\n      g.globalAlpha = 1;\n      g.textBaseline = \"middle\";\n      g.textAlign = \"left\";\n      pixel(g, Math.min(W, H) * 0.04, \"700\");\n      g.fillStyle = rgba(ROUTE, 1);\n      g.fillText(\"夜班配送\", L.pad, L.bar / 2);\n      pixel(g, Math.min(W, H) * 0.028);\n      g.fillStyle = rgba(PICK, 1);\n      g.globalAlpha = 0.9;\n      g.fillText(S.phase === \"run\" ? \"出发了 · 现在只能看\"\n        : (S.phase === \"settle\" ? \"本趟结算\" : \"第 \" + S.trip + \" 趟 · 画路线\"),\n        L.pad + Math.min(W * 0.16, 170), L.bar / 2);\n      g.globalAlpha = 1;\n\n      // 右栏：预算（这一件唯一的难度旋钮，全部摊开给玩家看）\n      var sx = L.sideX, sy = L.bar + L.pad * 1.4, lh = Math.min(W, H) * 0.042;\n      pixel(g, Math.min(W, H) * 0.03, \"700\");\n      g.fillStyle = rgba(PICK, 1);\n      g.fillText(\"油量\", sx, sy);\n\n      var barW = L.side, barH = Math.max(10, Math.min(W, H) * 0.026);\n      var full = Math.max(0, Math.min(1, S.fuel / FUEL));\n      g.globalAlpha = 0.3;\n      g.fillStyle = rgba(WALL, 1);\n      g.fillRect(sx, sy + lh * 0.5, barW, barH);\n      g.globalAlpha = 0.95;\n      g.fillStyle = rgba(S.fuel < BEST ? PICK : ROUTE, 1);\n      g.fillRect(sx, sy + lh * 0.5, barW * full, barH);\n      g.globalAlpha = 1;\n\n      pixel(g, Math.min(W, H) * 0.027);\n      g.fillStyle = rgba(ROUTE, 1);\n      var rows = [\n        \"还剩 \" + S.fuel + \" 格油\",\n        \"这一趟最少 \" + BEST + \" 步\",\n        \"已画 \" + (S.route.length - 1) + \" 步\",\n        \"已取 \" + ((S.got[0] ? 1 : 0) + (S.got[1] ? 1 : 0) + (S.got[2] ? 1 : 0)) + \" / 3 件\"\n      ];\n      for (i = 0; i < rows.length; i++) {\n        g.globalAlpha = i === 1 ? 0.7 : 0.95;\n        g.fillText(rows[i], sx, sy + lh * (2 + i));\n      }\n      g.globalAlpha = 1;\n\n      if (S.lastRun) {\n        pixel(g, Math.min(W, H) * 0.025);\n        g.fillStyle = rgba(PICK, 1);\n        g.globalAlpha = 0.85;\n        g.fillText(\"上一趟：\" + S.lastRun.steps + \" 步 / 取 \" + S.lastRun.got + \" 件\",\n          sx, sy + lh * 6.4);\n        g.fillText(S.why, sx, sy + lh * 7.4);\n        g.globalAlpha = 1;\n      }\n\n      // 底部指令条\n      g.globalAlpha = 0.45;\n      g.fillStyle = rgba(WALL, 1);\n      g.fillRect(0, L.footTop, W, L.foot);\n      g.globalAlpha = 1;\n      pixel(g, Math.min(W, H) * 0.026);\n      g.textAlign = \"left\";\n      g.fillStyle = rgba(ROUTE, 1);\n      g.globalAlpha = 0.85;\n      g.fillText(\"点相邻格画路线　方向键也能走\",\n        L.pad, L.footTop + L.foot / 2);\n      g.globalAlpha = 1;\n\n      // 触屏完整路径：画完路线后不用借键盘，直接点“出发”；撤销也有同等入口。\n      if (S.phase === \"plan\" && !S.over) {\n        var buttons = actionBoxes();\n        var paintButton = function (box, label, enabled, strong) {\n          g.globalAlpha = enabled ? (strong ? 0.92 : 0.65) : 0.22;\n          g.fillStyle = rgba(strong ? ROUTE : WALL, 1);\n          g.fillRect(box.x, box.y, box.w, box.h);\n          g.globalAlpha = enabled ? 0.95 : 0.42;\n          g.strokeStyle = rgba(strong ? ROUTE : PICK, 1);\n          g.lineWidth = 1.5;\n          g.strokeRect(box.x + 0.75, box.y + 0.75, box.w - 1.5, box.h - 1.5);\n          pixel(g, Math.min(box.h * 0.46, Math.min(W, H) * 0.026), \"700\");\n          g.textAlign = \"center\";\n          g.textBaseline = \"middle\";\n          g.fillStyle = rgba(strong ? NIGHT : ROUTE, 1);\n          g.fillText(label, box.x + box.w / 2, box.y + box.h / 2);\n          g.textBaseline = \"alphabetic\";\n          g.globalAlpha = 1;\n        };\n        paintButton(buttons.undo, \"撤一步\", S.route.length > 1, false);\n        paintButton(buttons.launch, \"出发\", S.route.length > 1, true);\n      }\n\n      if (S.over) {\n        g.textAlign = \"right\";\n        pixel(g, Math.min(W, H) * 0.03, \"700\");\n        g.fillStyle = rgba(S.over === \"win\" ? ROUTE : PICK, 1);\n        g.fillText((S.over === \"win\" ? \"送完了　\" : \"今晚到此为止　\") + S.why + \"　按一下再来\",\n          W - L.pad, L.footTop + L.foot / 2);\n      }\n    },\n\n    __probe: function () {\n      var L = layout();\n      var buttons = actionBoxes();\n      return {\n        over: S.over, phase: S.phase, fuel: S.fuel, best: BEST, trip: S.trip,\n        routeLen: S.route.length - 1, head: S.route[S.route.length - 1],\n        at: S.at, acts: S.acts,\n        got: [S.got[0], S.got[1], S.got[2]],\n        cols: COLS, rows: ROWS,\n        grid: GRID.slice(), start: START, exit: EXIT, picks: PICKS.slice(),\n        geom: { ox: L.ox, oy: L.oy, tile: L.tile, launch: buttons.launch, undo: buttons.undo }\n      };\n    }\n  };\n})();\n\n\n(function () {\n  \"use strict\";\n  var cv = document.getElementById(\"stage\");\n  var g = cv.getContext(\"2d\", { alpha: false });\n  var W = 0, H = 0, started = false;\n\n  function fit() {\n    var dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = cv.clientWidth || window.innerWidth;\n    H = cv.clientHeight || window.innerHeight;\n    cv.width = Math.round(W * dpr);\n    cv.height = Math.round(H *