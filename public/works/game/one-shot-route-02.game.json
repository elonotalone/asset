{
  "sourceFormat": "oceanleo.game-document.v1",
  "source": "<!doctype html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>一次点火</title>\n<style>\n  :root { --void:#0b1022; --ink:#e8ecf5; --go:#ffd45e; --bad:#ff6b6b; }\n  * { box-sizing: border-box; }\n  html, body { margin:0; height:100%; background:var(--void); color:var(--ink);\n    font-family: ui-sans-serif, system-ui, \"PingFang SC\", \"Noto Sans CJK SC\", sans-serif; }\n  #wrap { min-height:100%; display:flex; align-items:center; justify-content:center; padding:12px; }\n  #stage { width:min(96vw, 880px); }\n  canvas { width:100%; height:auto; display:block; border-radius:14px; background:var(--void);\n    touch-action: none; cursor: pointer; }\n</style>\n</head>\n<body>\n<div id=\"wrap\"><div id=\"stage\"><canvas id=\"board\" width=\"880\" height=\"616\"></canvas></div></div>\n<script>\n(function () {\n  \"use strict\";\n\n  // 资产槽位表 —— 换皮只改这张表，玩法一行都不用动。\n  // 每个键是一个槽，值是闭包内的相对路径；文件换掉，画面就换掉。\n  // 目录名带件名前缀是闭包约定（`base/game.md` §资产目录）：货架是平铺的，\n  // 裸 assets/ 会让下一件带贴图的游戏和这一件抢同一个目录。\n  var ASSETS = {\n    ship:      \"./one-shot-route-02.assets/ship.png\",\n    station:   \"./one-shot-route-02.assets/station.png\",\n    rockBig:   \"./one-shot-route-02.assets/rock-big.png\",\n    rockSmall: \"./one-shot-route-02.assets/rock-small.png\",\n    star:      \"./one-shot-route-02.assets/star.png\",\n    dust:      \"./one-shot-route-02.assets/star-tiny.png\",\n    burst:     \"./one-shot-route-02.assets/burst.png\",\n    warn:      \"./one-shot-route-02.assets/warn.png\"\n  };\n\n  var COLS = 11, ROWS = 7, CELL = 72, PAD_X = 44, PAD_Y = 96;\n  var W = 880, H = 616;\n\n  // 三张固定盘面。**不随机**：随机会让\"输了\"变成运气问题，而这个玩法的全部尊严\n  // 在于预算是自己算错的。\n  //\n  // 每张的 fuel 都比**最短合法线**多留几步（4 / 3 / 2，越往后越紧）。\n  // 那条线由 build.mjs 的 shortestLegalRoute() 按真规则搜出来——四邻、不许自交、\n  // 穿完补给、停在站上——盘面一改就重算，改瘦了当场不让出货。\n  var BOARDS = [\n    { fuel: 18, ship: [0, 3], goal: [10, 3],\n      rocks: [[3,1],[3,2],[3,4],[3,5],[6,0],[6,1],[6,2],[6,5],[6,6],[8,3]],\n      stars: [[3,3],[7,5]] },\n    { fuel: 25, ship: [0, 6], goal: [10, 0],\n      rocks: [[2,5],[2,4],[4,6],[4,5],[4,4],[6,3],[6,2],[6,1],[8,4],[8,3],[9,3]],\n      stars: [[5,6],[9,5]] },\n    { fuel: 26, ship: [5, 6], goal: [5, 0],\n      rocks: [[4,4],[5,4],[6,4],[2,2],[3,2],[7,2],[8,2],[5,1],[0,3],[10,3]],\n      stars: [[1,5],[9,5],[5,3]] }\n  ];\n\n  var canvas = document.getElementById(\"board\");\n  var g = canvas.getContext(\"2d\");\n\n  var img = {}, ready = {};\n  Object.keys(ASSETS).forEach(function (slot) {\n    var el = new Image();\n    el.onload = function () { ready[slot] = true; draw(); };\n    el.onerror = function () { ready[slot] = false; draw(); };\n    el.src = ASSETS[slot];\n    img[slot] = el;\n  });\n\n  // 背景尘点：固定位置，不用随机数，每次装载长一个样。\n  var DUST = [];\n  (function () {\n    var seed = 20260816;\n    for (var i = 0; i < 46; i++) {\n      seed = (seed * 1103515245 + 12345) % 2147483648;\n      var x = (seed % W), y = ((seed >> 7) % H), s = 6 + ((seed >> 13) % 10);\n      DUST.push([x, y, s]);\n    }\n  })();\n\n  var state = null, boardIndex = 0, tick = 0;\n\n  function makeState(index) {\n    var b = BOARDS[index % BOARDS.length];\n    return {\n      board: b,\n      route: [b.ship.slice()],\n      phase: \"plot\",           // plot → fly → win / lose\n      flyAt: 0, flyT: 0,\n      taken: {},               // 已收到的星\n      crash: null,\n      why: \"\"\n    };\n  }\n\n  function key(c, r) { return c + \",\" + r; }\n  function isRock(b, c, r) {\n    for (var i = 0; i < b.rocks.length; i++) if (b.rocks[i][0] === c && b.rocks[i][1] === r) return true;\n    return false;\n  }\n  function rockKind(c, r) { return (c * 7 + r * 3) % 2 === 0 ? \"rockBig\" : \"rockSmall\"; }\n  function inRoute(s, c, r) {\n    for (var i = 0; i < s.route.length; i++) if (s.route[i][0] === c && s.route[i][1] === r) return i;\n    return -1;\n  }\n  function cellX(c) { return PAD_X + c * CELL; }\n  function cellY(r) { return PAD_Y + r * CELL; }\n\n  function tryExtend(c, r) {\n    if (state.phase !== \"plot\") return;\n    if (c < 0 || r < 0 || c >= COLS || r >= ROWS) return;\n    var last = state.route[state.route.length - 1];\n    var prev = state.route[state.route.length - 2];\n    if (prev && prev[0] === c && prev[1] === r) { state.route.pop(); draw(); return; }  // 原路撤回\n    if (Math.abs(last[0] - c) + Math.abs(last[1] - r) !== 1) return;                    // 只走四邻\n    if (inRoute(state, c, r) >= 0) return;                                              // 不许自交\n    if (state.route.length - 1 >= state.board.fuel) return;                             // 预算到顶\n    state.route.push([c, r]);\n    draw();\n  }\n\n  function launch() {\n    if (state.phase !== \"plot\") return;\n    if (state.route.length < 2) { state.why = \"还没画路线\"; draw(); return; }\n    state.phase = \"fly\"; state.flyAt = 0; state.flyT = 0; state.why = \"\";\n  }\n\n  function restart(next) {\n    boardIndex = next ? boardIndex + 1 : boardIndex;\n    state = makeState(boardIndex);\n    draw();\n  }\n\n  canvas.addEventListener(\"pointerdown\", function (e) {\n    var box = canvas.getBoundingClientRect();\n    var x = (e.clientX - box.left) * (W / box.width);\n    var y = (e.clientY - box.top) * (H / box.height);\n    if (state.phase === \"win\" || state.phase === \"lose\") { restart(state.phase === \"win\"); return; }\n    if (y < PAD_Y - 26) { launch(); return; }\n    tryExtend(Math.floor((x - PAD_X) / CELL), Math.floor((y - PAD_Y) / CELL));\n  });\n\n  window.addEventListener(\"keydown\", function (e) {\n    var k = e.key;\n    if (k === \"r\" || k === \"R\") { restart(false); return; }\n    if (state.phase === \"win\" || state.phase === \"lose\") {\n      if (k === \" \" || k === \"Enter\") { restart(state.phase === \"win\"); e.preventDefault(); }\n      return;\n    }\n    if (k === \" \" || k === \"Enter\") { launch(); e.preventDefault(); return; }\n    var last = state.route[state.route.length - 1];\n    if (k === \"ArrowLeft\")  { tryExtend(last[0] - 1, last[1]); e.preventDefault(); }\n    if (k === \"ArrowRight\") { tryExtend(last[0] + 1, last[1]); e.preventDefault(); }\n    if (k === \"ArrowUp\")    { tryExtend(last[0], last[1] - 1); e.preventDefault(); }\n    if (k === \"ArrowDown\")  { tryExtend(last[0], last[1] + 1); e.preventDefault(); }\n    if (k === \"Backspace\" && state.route.length > 1) { state.route.pop(); draw(); e.preventDefault(); }\n  });\n\n  function stamp(slot, x, y, size, rot) {\n    var el = img[slot];\n    if (ready[slot] && el.naturalWidth) {\n      g.save();\n      g.translate(x, y);\n      if (rot) g.rotate(rot);\n      g.drawImage(el, -size / 2, -size / 2, size, size);\n      g.restore();\n      return true;\n    }\n    return false;\n  }\n\n  function fallbackDot(x, y, size, color) {\n    g.fillStyle = color;\n    g.beginPath(); g.arc(x, y, size / 2, 0, Math.PI * 2); g.fill();\n  }\n\n  function draw() {\n    var s = state, b = s.board;\n    g.fillStyle = \"#0b1022\"; g.fillRect(0, 0, W, H);\n\n    g.globalAlpha = 0.55;\n    for (var i = 0; i < DUST.length; i++) {\n      if (!stamp(\"dust\", DUST[i][0], DUST[i][1], DUST[i][2])) {\n        fallbackDot(DUST[i][0], DUST[i][1], 2, \"#33406b\");\n      }\n    }\n    g.globalAlpha = 1;\n\n    // 盘面格线\n    g.strokeStyle = \"rgba(120,146,214,0.16)\"; g.lineWidth = 1;\n    for (var c = 0; c <= COLS; c++) {\n      g.beginPath(); g.moveTo(cellX(c), cellY(0)); g.lineTo(cellX(c), cellY(ROWS)); g.stroke();\n    }\n    for (var r = 0; r <= ROWS; r++) {\n      g.beginPath(); g.moveTo(cellX(0), cellY(r)); g.lineTo(cellX(COLS), cellY(r)); g.stroke();\n    }\n\n    // 已画的线\n    if (s.route.length > 1) {\n      g.strokeStyle = s.phase === \"fly\" ? \"#ffd45e\" : \"#7fd3ff\";\n      g.lineWidth = 6; g.lineCap = \"round\"; g.lineJoin = \"round\";\n      g.beginPath();\n      g.moveTo(cellX(s.route[0][0]) + CELL / 2, cellY(s.route[0][1]) + CELL / 2);\n      for (var i2 = 1; i2 < s.route.length; i2++) {\n        g.lineTo(cellX(s.route[i2][0]) + CELL / 2, cellY(s.route[i2][1]) + CELL / 2);\n      }\n      g.stroke();\n    }\n\n    // 陨石\n    for (var i3 = 0; i3 < b.rocks.length; i3++) {\n      var rc = b.rocks[i3];\n      var cx = cellX(rc[0]) + CELL / 2, cy = cellY(rc[1]) + CELL / 2;\n      if (!stamp(rockKind(rc[0], rc[1]), cx, cy, CELL - 8)) fallbackDot(cx, cy, CELL - 20, \"#5b6584\");\n    }\n\n    // 星标（没收到的才画）\n    for (var i4 = 0; i4 < b.stars.length; i4++) {\n      var st = b.stars[i4];\n      if (s.taken[key(st[0], st[1])]) continue;\n      var sx = cellX(st[0]) + CELL / 2, sy = cellY(st[1]) + CELL / 2;\n      var pulse = 1 + 0.06 * Math.sin(tick / 12 + i4);\n      if (!stamp(\"star\", sx, sy, (CELL - 26) * pulse)) fallbackDot(sx, sy, 16, \"#ffd45e\");\n    }\n\n    // 终点站\n    var gx = cellX(b.goal[0]) + CELL / 2, gy = cellY(b.goal[1]) + CELL / 2;\n    if (!stamp(\"station\", gx, gy, CELL - 4)) fallbackDot(gx, gy, CELL - 16, \"#7fd3ff\");\n\n    // 飞船\n    var pos = shipPos();\n    if (!stamp(\"ship\", pos.x, pos.y, CELL - 14, pos.rot)) fallbackDot(pos.x, pos.y, CELL - 26, \"#e8ecf5\");\n\n    if (s.crash) {\n      var bx = cellX(s.crash[0]) + CELL / 2, by = cellY(s.crash[1]) + CELL / 2;\n      if (!stamp(\"burst\", bx, by, CELL + 18)) fallbackDot(bx, by, CELL, \"#ff6b6b\");\n    }\n\n    drawHud();\n  }\n\n  function shipPos() {\n    var s = state;\n    var a = s.route[Math.min(s.flyAt, s.route.length - 1)];\n    var bcell = s.route[Math.min(s.flyAt + 1, s.route.length - 1)];\n    var t = s.phase === \"fly\" ? s.flyT : 0;\n    var x = cellX(a[0] + (bcell[0] - a[0]) * t) + CELL / 2;\n    var y = cellY(a[1] + (bcell[1] - a[1]) * t) + CELL / 2;\n    var dx = bcell[0] - a[0], dy = bcell[1] - a[1];\n    var rot = 0;\n    if (dx === 1) rot = Math.PI / 2; else if (dx === -1) rot = -Math.PI / 2; else if (dy === 1) rot = Math.PI;\n    return { x: x, y: y, rot: rot };\n  }\n\n  function drawHud() {\n    var s = state, b = s.board;\n    var used = s.route.length - 1, left = b.fuel - used;\n    var got = 0;\n    for (var i = 0; i < b.stars.length; i++) if (s.taken[key(b.stars[i][0], b.stars[i][1])]) got++;\n\n    g.fillStyle = \"#e8ecf5\";\n    g.font = \"600 26px ui-sans-serif, system-ui, sans-serif\";\n    g.textBaseline = \"middle\";\n    g.fillText(\"燃料 \" + left + \" / \" + b.fuel, PAD_X, 40);\n    g.fillText(\"补给 \" + got + \" / \" + b.stars.length, PAD_X + 250, 40);\n\n    var hint = s.phase === \"plot\"\n      ? \"点格子或按方向键连出整条线 · 空格点火\"\n      : s.phase === \"fly\" ? \"点火后不接受输入\" : \"点一下或按空格继续\";\n    g.fillStyle = \"#8ea0cc\";\n    g.font = \"400 20px ui-sans-serif, system-ui, sans-serif\";\n    g.textAlign = \"right\";\n    g.fillText(hint, W - PAD_X, 40);\n    g.textAlign = \"left\";\n\n    if (s.why) {\n      if (!stamp(\"warn\", W / 2 - 150, 40, 30)) fallbackDot(W / 2 - 150, 40, 20, \"#ff6b6b\");\n      g.fillStyle = \"#ff6b6b\";\n      g.font = \"600 22px ui-sans-serif, system-ui, sans-serif\";\n      g.fillText(s.why, W / 2 - 128, 40);\n    }\n\n    if (s.phase === \"win\" || s.phase === \"lose\") {\n      g.fillStyle = \"rgba(11,16,34,0.82)\";\n      g.fillRect(0, H / 2 - 78, W, 156);\n      g.fillStyle = s.phase === \"win\" ? \"#ffd45e\" : \"#ff6b6b\";\n      g.font = \"700 46px ui-sans-serif, system-ui, sans-serif\";\n      g.textAlign = \"center\";\n      g.fillText(s.phase === \"win\" ? \"进站\" : \"没到站\", W / 2, H / 2 - 16);\n      g.fillStyle = \"#c8d2ee\";\n      g.font = \"400 22px ui-sans-serif, system-ui, sans-serif\";\n      g.fillText(s.phase === \"win\" ? \"下一张盘面：点一下或按空格\" : (s.why || \"按 R 重画这一张\"), W / 2, H / 2 + 34);\n      g.textAlign = \"left\";\n    }\n  }\n\n  function step() {\n    tick++;\n    var s = state;\n    if (s.phase === \"fly\") {\n      s.flyT += 0.12;\n      if (s.flyT >= 1) {\n        s.flyT = 0; s.flyAt++;\n        var at = s.route[Math.min(s.flyAt, s.route.length - 1)];\n        if (isRock(s.board, at[0], at[1])) {\n          s.crash = at; s.phase = \"lose\"; s.why = \"撞上了，按 R 重画这一张\";\n        } else {\n          if (inStars(s.board, at)) s.taken[key(at[0], at[1])] = true;\n          if (s.flyAt >= s.route.length - 1) {\n            var atGoal = at[0] === s.board.goal[0] && at[1] === s.board.goal[1];\n            var allStars = Object.keys(s.taken).length === s.board.stars.length;\n            if (atGoal && allStars) { s.phase = \"win\"; s.why = \"\"; }\n            else { s.phase = \"lose\"; s.why = atGoal ? \"补给没收齐\" : \"线到头了，人还在半路\"; }\n          }\n        }\n      }\n    }\n    draw();\n    requestAnimationFrame(step);\n  }\n\n  function inStars(b, cell) {\n    for (var i = 0; i < b.stars.length; i++) if (b.stars[i][0] === cell[0] && b.stars[i][1] === cell[1]) return true;\n    return false;\n  }\n\n  state = makeState(0);\n  draw();\n  requestAnimationFrame(step);\n})();\n</script>\n</body>\n</html>",
  "sizeBytes": 13038,
  "origin": "ai",
  "manifest": {
    "title": "一次点火",
    "summary": "看清陨石带和燃料，一次把整条航线画完，然后点火——出发之后不接受任何输入。补给收齐、燃料够、进站，才算这一趟成了。",
    "tags": [
      "路径规划",
      "一次成行",
      "外部素材"
    ],
    "credits": "OceanLeo (OCEANLEO-AIGEN);随附原料:'Simple Space' by Kenney (kenney.nl) — CC0 1.0 Universal(CC0-1.0)"
  }
}
