{
  "sourceFormat": "oceanleo.game-document.v1",
  "source": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<meta name=\"description\" content=\"一款没有计时器的调水解谜：注水会引发连锁漫堤，排海是代价，八次闸次之内把全盘水位降到二以内。\">\n<title>堤坝调水</title>\n<style>\nhtml, body { margin: 0; padding: 0; height: 100%; background: #F2EBDD; overflow: hidden; }\nbody { touch-action: none; -webkit-user-select: none; user-select: none; }\n#stage { display: block; width: 100%; height: 100%; }\n#fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\n  font: 16px/1.7 system-ui, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  color: #fff; opacity: .75; text-align: center; padding: 2rem; }\n</style>\n</head>\n<body>\n<canvas id=\"stage\" role=\"img\" aria-label=\"一款没有计时器的调水解谜：注水会引发连锁漫堤，排海是代价，八次闸次之内把全盘水位降到二以内。\"></canvas>\n<noscript><div id=\"fallback\">这是一款需要 JavaScript 才能运行的小游戏：一款没有计时器的调水解谜：注水会引发连锁漫堤，排海是代价，八次闸次之内把全盘水位降到二以内。</div></noscript>\n<script>\n// 堤坝调水 —— 玩法风格「慢账」（slow-ledger-tactics）\n// 循环：读一遍全公开的水位盘 → 在 16 个落点里权衡代价 → 注水后按写死的规则连锁漫堤 →\n//      闸次少一次、排海账多一笔，回到读盘面。\n// 难度只来自计算：没有计时器、没有暗格、没有随机数。盘面固定，玩家不动它就不动。\nvar bundle = (function () {\n  \"use strict\";\n\n  var K = {\n    n: 4,                 // 盘面边长\n    gates: 8,             // 闸次预算（这一局能注几次水）\n    quota: 30,            // 排海配额：漫出堤外的水记在这里，超了就是决堤\n    safe: 2,              // 安全线：全盘水位 ≤2 即调水完成\n    brim: 4,              // 漫堤线：水位到 4 就把四份水平分给四邻\n    waveMs: 190,          // 连锁一波显现的间隔——宁可慢，也要让人看清因果\n    settleMs: 120         // 最后一波结束后的停顿，收势用\n  };\n\n  // 初始盘面写死一张（solve.mjs 选盘时验过：8 闸次内可解，最省的一条线排海 24 份）。\n  // 每局都是同一张，因为这个风格里「运气好」是设计事故。\n  var BOARD = [2, 3, 3, 2,\n               3, 3, 3, 3,\n               3, 3, 3, 3,\n               2, 3, 3, 2];\n\n  // 纸与墨：一个暖浅底、一个近黑的墨、一个只表代价的红、一个表「已确定」的中性灰。\n  var PAPER = [242, 235, 221], INK = [27, 26, 23], COST = [178, 58, 47], CALM = [158, 151, 136];\n  function rgba(c, a) { return \"rgba(\" + c[0] + \",\" + c[1] + \",\" + c[2] + \",\" + a + \")\"; }\n\n  var W = 0, H = 0, S = null;\n\n  function finite(v, f) { return (typeof v === \"number\" && isFinite(v)) ? v : f; }\n  function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }\n\n  function fresh() {\n    return {\n      cells: BOARD.slice(),\n      phase: \"brief\",     // brief → play → over\n      gatesUsed: 0,\n      spill: 0,\n      over: null,\n      history: [],        // 撤销栈：这个风格里唯一允许的容错\n      last: null,         // 上一步的账：落点 / 波数 / 排海份数\n      chain: null,        // 正在显现的连锁：{ waves:[…], at, timer, hot }\n      pourAt: -1\n    };\n  }\n\n  function snapshot() {\n    return {\n      cells: S.cells.slice(), gatesUsed: S.gatesUsed, spill: S.spill,\n      last: S.last, pourAt: S.pourAt\n    };\n  }\n\n  function threes(cells) {\n    var n = 0;\n    for (var i = 0; i < cells.length; i++) if (cells[i] > K.safe) n += 1;\n    return n;\n  }\n\n  /** 漫堤推演。返回逐波的账：每波哪些格子漫出、这一波排海几份。规则写死，无随机。 */\n  function settle(cells) {\n    var g = cells.slice(), waves = [], spill = 0, guard = 0;\n    for (;;) {\n      var hot = [];\n      for (var i = 0; i < g.length; i++) if (g[i] >= K.brim) hot.push(i);\n      if (!hot.length) return { cells: g, waves: waves, spill: spill };\n      var out = 0;\n      for (var h = 0; h < hot.length; h++) {\n        var idx = hot[h], r = Math.floor(idx / K.n), c = idx % K.n;\n        g[idx] -= K.brim;\n        var d = [[-1, 0], [1, 0], [0, -1], [0, 1]];\n        for (var k = 0; k < 4; k++) {\n          var nr = r + d[k][0], nc = c + d[k][1];\n          if (nr < 0 || nr >= K.n || nc < 0 || nc >= K.n) out += 1;\n          else g[nr * K.n + nc] += 1;\n        }\n      }\n      spill += out;\n      waves.push({ hot: hot, cells: g.slice(), out: out });\n      guard += 1;\n      if (guard > 200) return { cells: g, waves: waves, spill: spill };\n    }\n  }\n\n  function judge() {\n    if (S.spill > K.quota) { S.over = \"lose\"; S.phase = \"over\"; return; }\n    if (threes(S.cells) === 0) { S.over = \"win\"; S.phase = \"over\"; return; }\n    if (S.gatesUsed >= K.gates) { S.over = \"lose\"; S.phase = \"over\"; }\n  }\n\n  function pour(idx) {\n    if (S.phase !== \"play\" || S.chain) return;\n    if (idx < 0 || idx >= K.n * K.n) return;\n    S.history.push(snapshot());\n    if (S.history.length > 64) S.history.shift();\n    var next = S.cells.slice();\n    next[idx] += 1;\n    var res = settle(next);\n    S.gatesUsed += 1;\n    S.pourAt = idx;\n    S.last = { at: idx, waves: res.waves.length, out: res.spill };\n    if (!res.waves.length) {\n      S.cells = res.cells;\n      judge();\n      return;\n    }\n    // 连锁不是一瞬间结算完的：一波一波显出来，玩家要看清水是从哪儿流到哪儿的。\n    S.chain = { waves: res.waves, at: -1, timer: 0, final: res.cells, spill: res.spill };\n  }\n\n  function undo() {\n    if (S.chain || !S.history.length) return;\n    if (S.phase === \"over\") S.phase = \"play\";\n    var p = S.history.pop();\n    S.cells = p.cells; S.gatesUsed = p.gatesUsed; S.spill = p.spill;\n    S.last = p.last; S.pourAt = p.pourAt; S.over = null;\n  }\n\n  // ── 版面：左栏盘面，右栏账目。两栏都常驻，信息永远同屏 ────────────────\n  function layout() {\n    var pad = Math.round(Math.min(W, H) * 0.045);\n    var leftW = Math.round((W - pad * 3) * 0.58);\n    var boardEdge = Math.min(leftW, H - pad * 2);\n    var bx = pad + Math.round((leftW - boardEdge) / 2);\n    var by = pad + Math.round((H - pad * 2 - boardEdge) / 2);\n    var rx = pad * 2 + leftW;\n    return {\n      pad: pad, bx: bx, by: by, edge: boardEdge, cell: boardEdge / K.n,\n      rx: rx, rw: W - rx - pad, ry: pad, rh: H - pad * 2\n    };\n  }\n\n  function cellAt(x, y) {\n    var L = layout();\n    var c = Math.floor((x - L.bx) / L.cell), r = Math.floor((y - L.by) / L.cell);\n    if (r < 0 || r >= K.n || c < 0 || c >= K.n) return -1;\n    return r * K.n + c;\n  }\n\n  function undoBox() {\n    var L = layout();\n    var h = Math.max(28, L.rh * 0.075);\n    return { x: L.rx, y: L.ry + L.rh - h, w: L.rw, h: h };\n  }\n\n  function hit(b, x, y) { return x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h; }\n\n  function font(g, px, weight) {\n    g.font = (weight ? weight + \" \" : \"\") + Math.round(px) +\n      \"px ui-monospace, 'SF Mono', Menlo, Consolas, monospace\";\n  }\n  function sans(g, px, weight) {\n    g.font = (weight ? weight + \" \" : \"\") + Math.round(px) +\n      \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n  }\n\n  return {\n    title: \"堤坝调水\",\n\n    setup: function (env) {\n      W = finite(env && env.width, 640);\n      H = finite(env && env.height, 640);\n      S = fresh();\n    },\n\n    resize: function (w, h) { W = finite(w, W); H = finite(h, H); },\n\n    pointer: function (x, y, phase) {\n      if (phase !== \"down\") return;\n      if (S.phase === \"brief\") { S.phase = \"play\"; return; }\n      if (S.phase === \"over\") {\n        if (hit(undoBox(), x, y)) { undo(); return; }\n        S = fresh(); S.phase = \"play\";\n        return;\n      }\n      if (hit(undoBox(), x, y)) { undo(); return; }\n      var i = cellAt(x, y);\n      if (i >= 0) pour(i);\n    },\n\n    key: function (code, phase) {\n      if (phase !== \"down\") return;\n      if (S.phase === \"brief\") { S.phase = \"play\"; return; }\n      if (code === \"KeyU\" || code === \"Backspace\") { undo(); return; }\n      if (S.phase === \"over\" && (code === \"Space\" || code === \"Enter\")) { S = fresh(); S.phase = \"play\"; }\n    },\n\n    update: function (dt) {\n      dt = clamp(finite(dt, 16.67), 0, 50);\n      if (!S.chain) return;   // 玩家不动手，世界就不动\n      var ch = S.chain;\n      ch.timer += dt;\n      var step = ch.at < 0 ? K.waveMs * 0.5 : K.waveMs;\n      if (ch.timer < step) return;\n      ch.timer = 0;\n      ch.at += 1;\n      if (ch.at < ch.waves.length) {\n        S.cells = ch.waves[ch.at].cells.slice();\n        return;\n      }\n      if (ch.at === ch.waves.length) { ch.timer = K.waveMs - K.settleMs; return; }\n      S.cells = ch.final.slice();\n      S.spill += ch.spill;\n      S.chain = null;\n      judge();\n    },\n\n    draw: function (g) {\n      var L = layout();\n      g.fillStyle = rgba(PAPER, 1);\n      g.fillRect(0, 0, W, H);\n\n      var dim = S.phase === \"brief\" ? 0.5 : 1;\n      var hot = (S.chain && S.chain.at >= 0 && S.chain.at < S.chain.waves.length)\n        ? S.chain.waves[S.chain.at].hot : [];\n\n      // 外框：一条墨线圈住整个盘，表示「堤内」。线外就是海。\n      g.strokeStyle = rgba(INK, 0.55 * dim);\n      g.lineWidth = 2;\n      g.strokeRect(L.bx - 6, L.by - 6, L.edge + 12, L.edge + 12);\n\n      for (var i = 0; i < K.n * K.n; i++) {\n        var r = Math.floor(i / K.n), c = i % K.n;\n        var x = L.bx + c * L.cell, y = L.by + r * L.cell;\n        var v = S.cells[i];\n        var risky = v > K.safe;\n        var toppling = hot.indexOf(i) >= 0;\n\n        // 格底：水位条从底往上长。安全的用中性灰（已确定），危格用墨（还要动它）。\n        var fillH = (L.cell - 8) * clamp(v / K.brim, 0, 1);\n        g.fillStyle = rgba(risky ? INK : CALM, risky ? 0.16 * dim : 0.22 * dim);\n        g.fillRect(x + 4, y + 4 + (L.cell - 8 - fillH), L.cell - 8, fillH);\n\n        g.strokeStyle = rgba(INK, (risky ? 0.75 : 0.28) * dim);\n        g.lineWidth = risky ? 2 : 1;\n        g.strokeRect(x + 4, y + 4, L.cell - 8, L.cell - 8);\n\n        // 正在漫堤的这一格：加一圈墨，指导要求「看清因果」，不用特效。\n        if (toppling) {\n          g.strokeStyle = rgba(INK, 0.9);\n          g.lineWidth = 3;\n          g.strokeRect(x + 1, y + 1, L.cell - 2, L.cell - 2);\n        }\n\n        font(g, L.cell * 0.4, risky ? \"600\" : \"400\");\n        g.textAlign = \"center\";\n        g.textBaseline = \"middle\";\n        g.fillStyle = rgba(risky ? INK : CALM, (risky ? 0.95 : 0.8) * dim);\n        g.fillText(String(v), x + L.cell / 2, y + L.cell / 2);\n\n        // 上一次注水的落点：一个墨点，告诉玩家「你刚动的是这里」。\n        if (i === S.pourAt && !S.chain) {\n          g.beginPath();\n          g.arc(x + L.cell - 14, y + 14, 3.5, 0, Math.PI * 2);\n          g.fillStyle = rgba(INK, 0.75 * dim);\n          g.fill();\n        }\n      }\n\n      // 排海：这一波流出堤外的水，只有它用红——红在这一件里只表代价。\n      if (hot.length) {\n        for (var h = 0; h < hot.length; h++) {\n          var hr = Math.floor(hot[h] / K.n), hc = hot[h] % K.n;\n          var cx = L.bx + hc * L.cell + L.cell / 2, cy = L.by + hr * L.cell + L.cell / 2;\n          var d = [[-1, 0], [1, 0], [0, -1], [0, 1]];\n          for (var k = 0; k < 4; k++) {\n            var nr = hr + d[k][0], nc = hc + d[k][1];\n            if (nr >= 0 && nr < K.n && nc >= 0 && nc < K.n) continue;\n            g.beginPath();\n            g.moveTo(cx, cy);\n            g.lineTo(cx + d[k][1] * L.cell * 0.85, cy + d[k][0] * L.cell * 0.85);\n            g.strokeStyle = rgba(COST, 0.8);\n            g.lineWidth = 2;\n            g.stroke();\n          }\n        }\n      }\n    },\n\n    hud: function (g) {\n      var L = layout();\n      var x = L.rx, y = L.ry;\n      var lh = clamp(L.rh * 0.052, 16, 30);\n\n      g.textAlign = \"left\";\n      g.textBaseline = \"top\";\n\n      sans(g, lh * 0.78, \"600\");\n      g.fillStyle = rgba(INK, 0.95);\n      g.fillText(\"堤坝调水\", x, y);\n      y += lh * 1.25;\n\n      g.beginPath();\n      g.moveTo(x, y); g.lineTo(x + L.rw, y);\n      g.strokeStyle = rgba(INK, 0.35); g.lineWidth = 1; g.stroke();\n      y += lh * 0.5;\n\n      if (S.phase === \"brief\") {\n        // 首屏：右栏是一整块规则摘要。没有隐藏信息，看完再开局。\n        var para = [\n          \"全盘 16 段堤，数字是水位。\",\n          \"点一格＝开一次上游闸，那一格 +1。\",\n          \"水位到 4 就漫堤：四份水平分给上下左右，\",\n          \"自己退 4；漫到堤外的记作排海。\",\n          \"\",\n          \"赢：全盘降到 \" + K.safe + \" 以内。\",\n          \"输：闸次用完仍有高水位，或排海超配额。\",\n          \"\",\n          \"闸次 \" + K.gates + \" 次　排海配额 \" + K.quota + \" 份\",\n          \"没有计时器，想多久都行。\",\n          \"按 U 撤销上一步。\",\n          \"\",\n          \"点任意处开局。\"\n        ];\n        // 右栏比字宽窄的时候必须自己折行：规则读不全等于隐藏信息，这个风格里不许有。\n        sans(g, Math.min(lh * 0.62, L.rw / 13.5));\n        var lines = [];\n        for (var p = 0; p < para.length; p++) {\n          var text = para[p];\n          if (!text) { lines.push(\"\"); continue; }\n          var cur = \"\";\n          for (var ci = 0; ci < text.length; ci++) {\n            var probe = cur + text.charAt(ci);\n            if (g.measureText(probe).width > L.rw && cur) { lines.push(cur); cur = text.charAt(ci); }\n            else cur = probe;\n          }\n          lines.push(cur);\n        }\n        for (var i = 0; i < lines.length; i++) {\n          g.fillStyle = rgba(INK, lines[i].indexOf(\"赢：\") === 0 || lines[i].indexOf(\"输：\") === 0 ? 0.9 : 0.72);\n          g.fillText(lines[i], x, y);\n          y += lh * 0.78;\n        }\n        return;\n      }\n\n      // 账目表：剩几次、排了多少、还差几格、上一步做了什么，全部同屏。\n      var rows = [\n        [\"闸次\", (K.gates - S.gatesUsed) + \" / \" + K.gates + \" 剩\", INK],\n        [\"排海\", S.spill + \" / \" + K.quota + \" 份\", COST],\n        [\"高水位\", threes(S.cells) + \" 段待降\", INK]\n      ];\n      for (var j = 0; j < rows.length; j++) {\n        sans(g, lh * 0.6);\n        g.fillStyle = rgba(CALM, 1);\n        g.fillText(rows[j][0], x, y);\n        font(g, lh * 0.78, \"600\");\n        g.textAlign = \"right\";\n        g.fillStyle = rgba(rows[j][2], 0.95);\n        g.fillText(rows[j][1], x + L.rw, y - lh * 0.08);\n        g.textAlign = \"left\";\n        y += lh * 1.15;\n      }\n\n      y += lh * 0.3;\n      g.beginPath();\n      g.moveTo(x, y); g.lineTo(x + L.rw, y);\n      g.strokeStyle = rgba(INK, 0.18); g.lineWidth = 1; g.stroke();\n      y += lh * 0.45;\n\n      sans(g, lh * 0.6);\n      g.fillStyle = rgba(CALM, 1);\n      g.fillText(\"上一步\", x, y);\n      y += lh * 0.85;\n      sans(g, lh * 0.62);\n      g.fillStyle = rgba(INK, 0.85);\n      if (S.last) {\n        var rr = Math.floor(S.last.at / K.n) + 1, cc = (S.last.at % K.n) + 1;\n        g.fillText(\"第 \" + rr + \" 行第 \" + cc + \" 列注水\", x, y);\n        y += lh * 0.8;\n        g.fillText(\"漫堤 \" + S.last.waves + \" 波\", x, y);\n        g.fillStyle = rgba(COST, 0.9);\n        g.fillText(\"　排海 \" + S.last.out + \" 份\", x + L.rw * 0.45, y);\n      } else {\n        g.fillText(\"还没有落子\", x, y);\n      }\n      y += lh * 1.3;\n\n      if (S.chain) {\n        sans(g, lh * 0.6);\n        g.fillStyle = rgba(INK, 0.7);\n        g.fillText(\"正在推演第 \" + clamp(S.chain.at + 1, 1, S.chain.waves.length) +\n          \" / \" + S.chain.waves.length + \" 波\", x, y);\n      }\n\n      if (S.phase === \"over\") {\n        var oy = L.ry + L.rh * 0.62;\n        sans(g, lh * 1.15, \"600\");\n        g.fillStyle = rgba(S.over === \"win\" ? INK : COST, 1);\n        g.fillText(S.over === \"win\" ? \"调水完成\" : \"决堤\", x, oy);\n        sans(g, lh * 0.62);\n        g.fillStyle = rgba(INK, 0.8);\n        g.fillText(S.over === \"win\"\n          ? \"用 \" + S.gatesUsed + \" 闸次，排海 \" + S.spill + \" 份。\"\n          : (S.spill > K.quota ? \"排海 \" + S.spill + \" 份，超配额 \" + (S.spill - K.quota) + \" 份。\"\n            : \"闸次用完，仍有 \" + threes(S.cells) + \" 段高水位。\"), x, oy + lh * 1.3);\n        g.fillStyle = rgba(CALM, 1);\n        g.fillText(\"点盘面重开一局\", x, oy + lh * 2.1);\n      }\n\n      // 撤销条：这个风格里唯一允许的容错，永远摆在同一个位置。\n      var b = undoBox();\n      g.strokeStyle = rgba(INK, S.history.length ? 0.5 : 0.15);\n      g.lineWidth = 1;\n      g.strokeRect(b.x, b.y, b.w, b.h);\n      sans(g, lh * 0.62);\n      g.textAlign = \"center\";\n      g.textBaseline = \"middle\";\n      g.fillStyle = rgba(INK, S.history.length ? 0.85 : 0.3);\n      g.fillText(\"撤销上一步（U）\", b.x + b.w / 2, b.y + b.h / 2);\n      g.textAlign = \"left\";\n      g.textBaseline = \"top\";\n    },\n\n    __probe: function () {\n      return {\n        phase: S.phase, over: S.over, cells: S.cells.slice(),\n        gatesUsed: S.gatesUsed, gatesLeft: K.gates - S.gatesUsed,\n        spill: S.spill, quota: K.quota, risky: threes(S.cells),\n        chaining: Boolean(S.chain), canUndo: S.history.length > 0,\n        last: S.last ? { at: S.last.at, waves: S.last.waves, out: S.last.out } : null\n     