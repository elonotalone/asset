{
  "sourceFormat": "oceanleo.game-document.v1",
  "source": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<meta name=\"description\" content=\"一款只考记性的小游戏：九宫格的灯按顺序亮起，全灭之后照原样按回去，每对一次序列加长一盏。\">\n<title>灯语</title>\n<style>\nhtml, body { margin: 0; padding: 0; height: 100%; background: #0C0E14; overflow: hidden; }\nbody { touch-action: none; -webkit-user-select: none; user-select: none; }\n#stage { display: block; width: 100%; height: 100%; }\n#fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\n  font: 16px/1.7 system-ui, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  color: #fff; opacity: .75; text-align: center; padding: 2rem; }\n</style>\n</head>\n<body>\n<canvas id=\"stage\" role=\"img\" aria-label=\"一款只考记性的小游戏：九宫格的灯按顺序亮起，全灭之后照原样按回去，每对一次序列加长一盏。\"></canvas>\n<noscript><div id=\"fallback\">这是一款需要 JavaScript 才能运行的小游戏：一款只考记性的小游戏：九宫格的灯按顺序亮起，全灭之后照原样按回去，每对一次序列加长一盏。</div></noscript>\n<script>\n// 灯语 —— 玩法风格「回声」（echo-recall）\n// 循环：场上按顺序点亮一串灯 → 全灭、屏上不留任何痕迹 → 你把顺序复现出来 →\n//      对错当场揭晓 → 序列加长一格，回到看灯。\n// 难度只来自记忆，旋钮只有一个：要记的量。复现阶段没有时限。\nvar bundle = (function () {\n  \"use strict\";\n\n  var K = {\n    cols: 3, rows: 3,\n    start: 4,             // 第一层要记几个\n    goal: 10,             // 记到这么长就是满灯（过关）\n    lead: 700,            // 开场「看好」的静默\n    onMs: 480,            // 展示：一盏灯亮多久\n    gapMs: 200,           // 展示：两盏之间的暗场\n    tapMs: 140,           // 复现：按下之后的一闪，闪完立刻收走（不留痕迹）\n    wrongMs: 620,         // 判错时错误色停留多久\n    replayOn: 360,        // 复盘：正确答案重放，一盏亮多久\n    replayGap: 150,\n    endPause: 520         // 复盘结束到结算之间的停顿\n  };\n\n  // 夜色打底 + 一冷一暖两个信号色 + 一个只在判错时出现的错误色。\n  var NIGHT = [12, 14, 20], COLD = [90, 169, 255], WARM = [255, 194, 75], WRONG = [215, 38, 61];\n  function rgba(c, a) { return \"rgba(\" + c[0] + \",\" + c[1] + \",\" + c[2] + \",\" + a + \")\"; }\n\n  var W = 0, H = 0, S = null;\n\n  function finite(v, f) { return (typeof v === \"number\" && isFinite(v)) ? v : f; }\n  function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }\n\n  // 定种子随机：不许用 Math.random（封面要求同输入同字节）。\n  // 玩家第一次落手时把手速的零头掺进种子——同一台机器上重开一局，序列就不一样了，\n  // 上一局背下来的东西帮不上忙。没有人碰过的时候（比如抓封面）走的是固定种子。\n  function rnd() {\n    S.seed = (S.seed * 1664525 + 1013904223) % 4294967296;\n    return S.seed / 4294967296;\n  }\n\n  function grow() {\n    var n = K.cols * K.rows;\n    var next = Math.floor(rnd() * n) % n;\n    if (S.seq.length && next === S.seq[S.seq.length - 1]) next = (next + 1 + Math.floor(rnd() * (n - 1))) % n;\n    S.seq.push(next);\n  }\n\n  function fresh(seed, best) {\n    S = {\n      seed: seed, best: best || 0,\n      seq: [], phase: \"show\", at: -1, timer: -K.lead,\n      typed: 0, lit: -1, flash: 0, flashKind: \"ok\", flashCell: -1,\n      over: null, overAge: 0, touched: false, frames: 0\n    };\n    for (var i = 0; i < K.start; i++) grow();\n    return S;\n  }\n\n  function beginShow() {\n    S.phase = \"show\";\n    S.at = -1;\n    S.timer = -K.lead * 0.5;\n    S.lit = -1;\n    S.typed = 0;\n  }\n\n  function beginReplay() {\n    S.phase = \"replay\";\n    S.at = -1;\n    S.timer = 0;\n    S.lit = -1;\n  }\n\n  function tap(i) {\n    if (S.phase !== \"input\" || S.over) return;\n    S.flash = K.tapMs;\n    S.flashCell = i;\n    if (i === S.seq[S.typed]) {\n      S.flashKind = \"ok\";\n      S.typed += 1;\n      if (S.typed >= S.seq.length) {\n        S.best = Math.max(S.best, S.seq.length);\n        if (S.seq.length >= K.goal) { S.over = \"win\"; S.phase = \"over\"; S.overAge = 0; return; }\n        grow();\n        beginShow();\n      }\n      return;\n    }\n    // 错了：先把错的那一下明确地打出来，再把正确答案完整重放一遍——\n    // 这个风格一半的乐趣在「原来是那个」。\n    S.flashKind = \"bad\";\n    S.best = Math.max(S.best, S.typed);\n    S.phase = \"wrong\";\n    S.timer = 0;\n  }\n\n  function layout() {\n    var bar = clamp(H * 0.11, 44, 92);\n    var foot = clamp(H * 0.10, 40, 84);\n    var free = { top: bar, h: H - bar - foot };\n    var edge = Math.min(W * 0.82, free.h * 0.94);\n    var cell = edge / K.cols;\n    return {\n      bar: bar, foot: foot, edge: edge, cell: cell,\n      gx: (W - edge) / 2, gy: bar + (free.h - edge) / 2, footTop: H - foot\n    };\n  }\n\n  function cellAt(x, y) {\n    var L = layout();\n    var c = Math.floor((x - L.gx) / L.cell), r = Math.floor((y - L.gy) / L.cell);\n    if (r < 0 || r >= K.rows || c < 0 || c >= K.cols) return -1;\n    return r * K.cols + c;\n  }\n\n  function hueOf(i) {\n    // 冷暖只用来分辨灯的种类，不表示好坏。同一盏灯永远是同一个颜色。\n    var r = Math.floor(i / K.cols), c = i % K.cols;\n    return ((r + c) % 2 === 0) ? COLD : WARM;\n  }\n\n  function sans(g, px, weight) {\n    g.font = (weight ? weight + \" \" : \"\") + Math.round(px) +\n      \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n  }\n\n  return {\n    title: \"灯语\",\n\n    setup: function (env) {\n      W = finite(env && env.width, 640);\n      H = finite(env && env.height, 640);\n      fresh(20260813, 0);\n    },\n\n    resize: function (w, h) { W = finite(w, W); H = finite(h, H); },\n\n    pointer: function (x, y, phase) {\n      if (phase !== \"down\") return;\n      if (!S.touched) {\n        S.touched = true;\n        S.seed = (S.seed ^ (S.frames * 2654435761 + Math.round(x) * 13 + Math.round(y) * 7)) >>> 0;\n      }\n      if (S.over) { fresh(S.seed, S.best); return; }\n      var i = cellAt(x, y);\n      if (i >= 0) tap(i);\n    },\n\n    key: function (code, phase) {\n      if (phase !== \"down\") return;\n      if (!S.touched) {\n        S.touched = true;\n        S.seed = (S.seed ^ (S.frames * 2654435761 + 91)) >>> 0;\n      }\n      if (S.over) { fresh(S.seed, S.best); return; }\n      // 键盘：小键盘/数字键 1–9 与九宫格一一对应，顺序与看到的一致。\n      var m = /^(?:Digit|Numpad)([1-9])$/.exec(code) || /^([1-9])$/.exec(code);\n      if (!m) return;\n      var d = Number(m[1]) - 1;\n      var r = 2 - Math.floor(d / 3), c = d % 3;   // 小键盘 7/8/9 在上排\n      tap(r * K.cols + c);\n    },\n\n    update: function (dt) {\n      dt = clamp(finite(dt, 16.67), 0, 50);\n      S.frames += 1;\n      S.flash = Math.max(0, S.flash - dt);\n\n      if (S.phase === \"input\") return;   // 复现阶段没有时限：玩家想坐多久都行\n\n      S.timer += dt;\n\n      if (S.phase === \"show\") {\n        var span = S.at < 0 ? 0 : (S.lit >= 0 ? K.onMs : K.gapMs);\n        if (S.timer < span) return;\n        S.timer = 0;\n        if (S.lit >= 0) { S.lit = -1; return; }      // 灯灭，进暗场\n        S.at += 1;\n        if (S.at >= S.seq.length) { S.phase = \"input\"; S.lit = -1; return; }\n        S.lit = S.seq[S.at];\n        return;\n      }\n\n      if (S.phase === \"wrong\") {\n        if (S.timer < K.wrongMs) return;\n        beginReplay();\n        return;\n      }\n\n      if (S.phase === \"replay\") {\n        var span2 = S.at < 0 ? 0 : (S.lit >= 0 ? K.replayOn : K.replayGap);\n        if (S.timer < span2) return;\n        S.timer = 0;\n        if (S.lit >= 0) { S.lit = -1; return; }\n        S.at += 1;\n        if (S.at >= S.seq.length) {\n          S.lit = -1;\n          S.over = \"lose\";\n          S.phase = \"over\";\n          S.overAge = 0;\n          return;\n        }\n        S.lit = S.seq[S.at];\n        return;\n      }\n\n      if (S.phase === \"over\") { S.overAge += dt; }\n    },\n\n    draw: function (g) {\n      var L = layout();\n      g.fillStyle = rgba(NIGHT, 1);\n      g.fillRect(0, 0, W, H);\n\n      var showing = S.phase === \"show\" || S.phase === \"replay\";\n      for (var i = 0; i < K.cols * K.rows; i++) {\n        var r = Math.floor(i / K.cols), c = i % K.cols;\n        var x = L.gx + c * L.cell, y = L.gy + r * L.cell;\n        var pad = L.cell * 0.09;\n        var s = L.cell - pad * 2;\n        var hue = hueOf(i);\n\n        var on = showing && S.lit === i;\n        var hit = S.flash > 0 && S.flashCell === i;\n        var bad = hit && S.flashKind === \"bad\";\n        // 亮度就是信息：暗＝没轮到它，亮＝现在是它。除此之外亮度不表示别的意思。\n        var a = on ? 0.95 : 0.10;\n        if (hit) a = Math.max(a, 0.30 + 0.6 * (S.flash / K.tapMs));\n\n        g.fillStyle = rgba(bad ? WRONG : hue, a);\n        g.beginPath();\n        g.roundRect(x + pad, y + pad, s, s, s * 0.16);\n        g.fill();\n\n        g.strokeStyle = rgba(bad ? WRONG : hue, on ? 0.9 : 0.22);\n        g.lineWidth = on ? 3 : 1.5;\n        g.beginPath();\n        g.roundRect(x + pad, y + pad, s, s, s * 0.16);\n        g.stroke();\n      }\n\n      // 判错的那一下：错误色只在这一瞬间出现，重放开始就收走。\n      if (S.phase === \"wrong\") {\n        g.strokeStyle = rgba(WRONG, 0.55);\n        g.lineWidth = 3;\n        g.strokeRect(L.gx - 8, L.gy - 8, L.edge + 16, L.edge + 16);\n      }\n    },\n\n    hud: function (g) {\n      var L = layout();\n      var pad = W * 0.06;\n\n      // 顶部状态条：这一层要记几个、历史最好。序列本身一个字都不写在这里。\n      g.textBaseline = \"middle\";\n      g.textAlign = \"left\";\n      sans(g, L.bar * 0.30, \"600\");\n      g.fillStyle = rgba(COLD, 0.85);\n      g.fillText(\"第 \" + S.seq.length + \" 盏 / \" + K.goal, pad, L.bar * 0.55);\n\n      g.textAlign = \"right\";\n      sans(g, L.bar * 0.26);\n      g.fillStyle = rgba(COLD, 0.45);\n      g.fillText(\"最好 \" + S.best, W - pad, L.bar * 0.55);\n\n      g.beginPath();\n      g.moveTo(pad, L.bar - 1);\n      g.lineTo(W - pad, L.bar - 1);\n      g.strokeStyle = rgba(COLD, 0.16);\n      g.lineWidth = 1;\n      g.stroke();\n\n      // 底部：一句话说清现在轮到谁，外加一道层数阶梯。\n      var cy = L.footTop + L.foot * 0.42;\n      g.textAlign = \"center\";\n      sans(g, L.foot * 0.30);\n      var say = S.phase === \"show\" ? \"看好\" :\n        (S.phase === \"input\" ? \"照着按　不限时\" :\n          (S.phase === \"wrong\" ? \"错了\" :\n            (S.phase === \"replay\" ? \"正确答案\" :\n              (S.over === \"win\" ? \"满灯　按一下再来\" : \"到此为止　按一下再来\"))));\n      g.fillStyle = rgba(S.phase === \"wrong\" ? WRONG : COLD, S.phase === \"input\" ? 0.5 : 0.8);\n      g.fillText(say, W / 2, cy);\n\n      var steps = K.goal - K.start + 1;\n      var sw = Math.min(W * 0.5, steps * L.foot * 0.16);\n      var gap = sw / steps;\n      var bx = (W - sw) / 2;\n      var by = L.footTop + L.foot * 0.78;\n      for (var i = 0; i < steps; i++) {\n        var done = i <= S.seq.length - K.start;\n        g.beginPath();\n        g.moveTo(bx + i * gap + gap * 0.15, by);\n        g.lineTo(bx + i * gap + gap * 0.85, by);\n        g.strokeStyle = rgba(WARM, done ? 0.75 : 0.18);\n        g.lineWidth = done ? 3 : 2;\n        g.stroke();\n      }\n\n      if (S.phase === \"over\") {\n        g.textAlign = \"center\";\n        sans(g, Math.min(W, H) * 0.11, \"600\");\n        g.fillStyle = rgba(S.over === \"win\" ? WARM : COLD, 0.92);\n        g.fillText(String(S.best), W / 2, L.gy + L.edge * 0.5);\n        sans(g, Math.min(W, H) * 0.035);\n        g.fillStyle = rgba(COLD, 0.6);\n        g.fillText(S.over === \"win\" ? \"十盏全记住了\" : \"记住了这么多盏\", W / 2, L.gy + L.edge * 0.5 + Math.min(W, H) * 0.09);\n      }\n    },\n\n    __probe: function () {\n      return {\n        phase: S.phase, over: S.over, lit: S.lit,\n        seqLen: S.seq.length, typed: S.typed, best: S.best,\n        goal: K.goal, touched: S.touched\n      };\n    }\n  };\n})();\n\n\n(function () {\n  \"use strict\";\n  var cv = document.getElementById(\"stage\");\n  var g = cv.getContext(\"2d\", { alpha: false });\n  var W = 0, H = 0, started = false;\n\n  function fit() {\n    var dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = cv.clientWidth || window.innerWidth;\n    H = cv.clientHeight || window.innerHeight;\n    cv.width = Math.round(W * dpr);\n    cv.height = Math.round(H * dpr);\n    g.setTransform(dpr, 0, 0, dpr, 0, 0);\n    if (started && bundle.resize) bundle.resize(W, H);\n  }\n\n  fit();\n  bundle.setup({ ctx: g, canvas: cv, width: W, height: H });\n  started = true;\n  window.addEventListener(\"resize\", fit);\n  window.addEventListener(\"orientationchange\", fit);\n\n  function at(e) {\n    var r = cv.getBoundingClientRect();\n    return [e.clientX - r.left, e.clientY - r.top];\n  }\n  function on(name, phase) {\n    cv.addEventListener(name, function (e) {\n      var p = at(e);\n      bundle.pointer(p[0], p[1], phase);\n      if (e.cancelable) e.preventDefault();\n    }, { passive: false });\n  }\n  on(\"pointerdown\", \"down\");\n  on(\"pointermove\", \"move\");\n  on(\"pointerup\", \"up\");\n  cv.addEventListener(\"pointercancel\", function () { bundle.pointer(-1, -1, \"up\"); });\n  cv.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n\n  window.addEventListener(\"keydown\", function (e) {\n    if (e.repeat) return;\n    bundle.key(e.code || e.key, \"down\");\n    if (e.code === \"Space\" || e.code === \"ArrowUp\" || e.code === \"ArrowDown\") e.preventDefault();\n  });\n  window.addEventListener(\"keyup\", function (e) { bundle.key(e.code || e.key, \"up\"); });\n\n  var last = 0;\n  function loop(ts) {\n    var dt = last ? Math.min(ts - last, 50) : 16.67;\n    last = ts;\n    bundle.update(dt, ts);\n    bundle.draw(g, ts);\n    bundle.hud(g, ts);\n    window.requestAnimationFrame(loop);\n  }\n  window.requestAnimationFrame(loop);\n})();\n\n</script>\n</body>\n</html>",
  "sizeBytes": 14099,
  "origin": "ai",
  "manifest": {
    "title": "灯语",
    "summary": "九盏灯按顺序亮一遍，然后全灭、屏上不留一点痕迹，你把顺序照按回去。对一次就加一盏，错一次就到此为止。复现不限时，想坐多久都行。",
    "tags": [
      "游戏",
      "记忆",
      "九宫格",
      "极简"
    ],
    "credits": "OceanLeo (OCEANLEO-AIGEN)"
  }
}
