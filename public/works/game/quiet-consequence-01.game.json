{
  "sourceFormat": "oceanleo.game-document.v1",
  "source": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<meta name=\"description\" content=\"一款纯文字的选择小游戏：一夜值班的七次取舍决定六种结局之一，全程没有限时、没有随机、一张图都没有。\">\n<title>潮位站的一夜</title>\n<style>\nhtml, body { margin: 0; padding: 0; height: 100%; background: #FBF7F0; overflow: hidden; }\nbody { touch-action: none; -webkit-user-select: none; user-select: none; }\n#stage { display: block; width: 100%; height: 100%; }\n#fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\n  font: 16px/1.7 system-ui, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  color: #fff; opacity: .75; text-align: center; padding: 2rem; }\n</style>\n</head>\n<body>\n<canvas id=\"stage\" role=\"img\" aria-label=\"一款纯文字的选择小游戏：一夜值班的七次取舍决定六种结局之一，全程没有限时、没有随机、一张图都没有。\"></canvas>\n<noscript><div id=\"fallback\">这是一款需要 JavaScript 才能运行的小游戏：一款纯文字的选择小游戏：一夜值班的七次取舍决定六种结局之一，全程没有限时、没有随机、一张图都没有。</div></noscript>\n<script>\n// 潮位站的一夜 —— 玩法风格「静默后果」（quiet-consequence）\n// 循环：读一小段处境 → 在几个都说得通的做法里挑一个 → 立刻看到眼前发生了什么，\n//      但看不到它改了哪个数 → 处境因此不同，回到读处境。\n// 难度只来自取舍：每个选项都至少让一样东西变好、一样东西变差。\n// 没有限时、没有随机、没有一张图；结局由累计的账决定，天亮时才摊开。\nvar bundle = (function () {\n  \"use strict\";\n\n  // 纸 + 墨 + 一支只用在「可以点的东西」上的棕金 + 一支只在结局屏分「成了 / 没成」的松绿\n  var PAPER = [251, 247, 240], INK = [42, 38, 34], TAP = [122, 92, 62], DONE = [47, 107, 79];\n  function rgba(c, a) { return \"rgba(\" + c[0] + \",\" + c[1] + \",\" + c[2] + \",\" + a + \")\"; }\n\n  var REVEAL_MS = 14;      // 正文一个字一个字接上来，每字多少毫秒（读完才给选项）\n  var START = { e: 0, t: 0, s: 4 };\n\n  // 每一幕：处境指示 + 正文 + 选项。选项的 d 是它悄悄改动的账，屏上永远不显示。\n  var SCENES = {\n    s1: {\n      at: \"二十三时四十分 · 雨\",\n      text: \"雨从傍晚开始下，值班室的窗玻璃像挂了一层水。潮位仪的针在纸带上画出一条不太规矩的线。交接的老周临走时说：今晚没什么事，别折腾。\",\n      opts: [\n        { text: \"把今晚的潮位记录从头翻一遍\", d: { e: 2, s: -1 }, to: \"s2\" },\n        { text: \"披上雨衣，去码头看一眼水线\", d: { e: 1, t: 1, s: -2 }, to: \"s3\" },\n        { text: \"按惯例填完表，早点靠一会\", d: { e: -1, s: 1 }, to: \"s4\" }\n      ]\n    },\n    s2: {\n      at: \"零时二十分 · 记录本\",\n      text: \"三个小时的读数摊在桌上。涨得不算快，可每一格都比预报多出一点。多出来的这一点，你说不清是仪器的脾气，还是海的脾气。\",\n      opts: [\n        { text: \"打电话把站长叫起来一起核对\", d: { e: 1, t: -1 }, to: \"s5\" },\n        { text: \"自己再核一遍，别半夜吵人\", d: { e: 1, s: -1 }, to: \"s5\" }\n      ]\n    },\n    s3: {\n      at: \"零时三十分 · 码头\",\n      text: \"水线比白天高出一个台阶。浪打在挡墙上，回头的水沫能溅到路面。老陈家的船亮着灯，两个人正往船上搬冰箱——他们打算凌晨出海。\",\n      opts: [\n        { text: \"先劝老陈今晚别出港\", d: { t: 1, s: -1 }, to: \"s5\" },\n        { text: \"先把水线高度量准了再说\", d: { e: 2, s: -1 }, to: \"s5\" }\n      ]\n    },\n    s4: {\n      at: \"零时十分 · 表格\",\n      text: \"表按老样子填完了，字迹工整，一栏没漏。窗外的雨声比一小时前重了一档。\",\n      opts: [\n        { text: \"表填完了，还是去看一眼\", d: { s: -1 }, to: \"s3\" },\n        { text: \"靠在椅子上眯一会儿\", d: { e: -1, s: 2 }, to: \"s5\" }\n      ]\n    },\n    s5: {\n      at: \"两时整 · 电话\",\n      text: \"电话响了，是老陈：站里怎么说？我们这趟货压了三天了。你手上有的，只是一条比预报涨得多一点的线。\",\n      opts: [\n        { text: \"让他们等到天亮再说\", d: { t: -1 }, to: \"s6\" },\n        { text: \"说不清就说没事，别耽误人家\", d: { e: -1, t: 1 }, to: \"s6\" },\n        { text: \"把手上的读数一条一条念给他听\", d: { e: 1, t: 1 }, to: \"s6\" }\n      ]\n    },\n    s6: {\n      at: \"三时整 · 值班室\",\n      text: \"雨没有要停的意思。离天亮还有三个小时：你可以再冒一趟雨，可以守着仪表看趋势，也可以趴一会儿。\",\n      opts: [\n        { text: \"再去测一次，这回带上尺子\", d: { e: 2, s: -2 }, to: \"s7\" },\n        { text: \"守着仪表，每十分钟记一格\", d: { e: 1, s: -1 }, to: \"s7\" },\n        { text: \"趴一会儿，四点再说\", d: { s: 2 }, to: \"s7\" }\n      ]\n    },\n    s7: {\n      at: \"四时十分 · 站长回电\",\n      text: \"站长的声音里全是睡意：说吧，什么事非得这个点打过来。\",\n      opts: [\n        { text: \"报数，请求天亮前封航\", d: {}, to: \"end\", tag: \"ask\" },\n        { text: \"只把情况说一遍，不提要求\", d: {}, to: \"end\", tag: \"tell\" },\n        { text: \"说没什么事，只是例行报告\", d: { e: -1 }, to: \"end\", tag: \"hush\" }\n      ]\n    }\n  };\n\n  var ENDINGS = {\n    signed: { win: true, title: \"封航令在天亮前签下\", text: \"站长听完你念的那串数，沉默了两秒，说：把纸带拍给我。六点零五分，封航通告贴在了码头口。老陈骂了两句，把冰箱又搬了下来。八点整，浪头翻过挡墙，路面积水到脚踝。\" },\n    doubted: { win: false, title: \"他信不过你\", text: \"你把数报得很清楚，可对面停了很久：这事你有把握？上回也是你说要封的。天亮时通告没有发。海面那天没出事——你到现在也不知道，那是因为你判断错了，还是因为运气。\" },\n    thin: { win: false, title: \"你张了嘴，但拿不出数\", text: \"你说出口才发现，能拿出来的只有一句「涨得比预报多一点」。站长说，等白班的人来看看再说。天亮了，风向变了，什么也没发生。你收拾东西下班，路过码头时没敢看老陈。\" },\n    without: { win: false, title: \"站长自己下了令，你的名字不在上面\", text: \"你只说了情况。他挂了电话，自己去调了另一头的数据，六点半发了封航通告。事情办成了，只是没有一个字是你争来的。你在交接本上写：夜间无异常。\" },\n    silent: { win: false, title: \"天亮了。你什么也没说过\", text: \"例行报告，一切正常。你把纸带卷好收进柜子。老陈的船六点出的港，中午安全回来了。你松了口气，然后开始想：如果那天没回来呢——这个念头你后来想了很多年。\" },\n    asleep: { win: false, title: \"你在值班室睡着了\", text: \"趴下去的时候只想着眯十分钟。醒来是五点四十，纸带上多了一段谁也没看着的曲线。你把那一段撕下来夹进本子，谁也没告诉。\" }\n  };\n\n  var W = 0, H = 0, S = null;\n\n  function finite(v, f) { return (typeof v === \"number\" && isFinite(v)) ? v : f; }\n\n  function fresh() {\n    S = {\n      scene: \"s1\", e: START.e, t: START.t, s: START.s,\n      // 开局这一页本来就已经印在纸上了：加载完就在读，没有开场页、没有空屏。\n      reveal: SCENES.s1.text.length, act: 1, log: [], trail: [\"s1\"],\n      over: null, ending: null, overAge: 0, acts: 0,\n      rows: [], rowH: 0\n    };\n    return S;\n  }\n\n  function serif(g, px, weight) {\n    g.font = (weight ? weight + \" \" : \"\") + Math.round(px) +\n      \"px 'Noto Sans CJK SC', Georgia, 'Songti SC', serif\";\n  }\n\n  function layout() {\n    var pad = Math.max(20, Math.min(W, H) * 0.062);\n    var col = Math.min(W - pad * 2, Math.max(360, W * 0.62));\n    return {\n      pad: pad, col: col, x: Math.round((W - col) / 2),\n      body: Math.min(W, H) * 0.038,\n      opt: Math.min(W, H) * 0.035,\n      small: Math.min(W, H) * 0.024,\n      lead: Math.min(W, H) * 0.062\n    };\n  }\n\n  function wrap(g, text, width) {\n    var lines = [], cur = \"\", i, ch;\n    for (i = 0; i < text.length; i++) {\n      ch = text.charAt(i);\n      if (g.measureText(cur + ch).width > width && cur) { lines.push(cur); cur = ch; }\n      else cur += ch;\n    }\n    if (cur) lines.push(cur);\n    return lines;\n  }\n\n  function scene() { return SCENES[S.scene]; }\n  function ready() { return S.over ? true : S.reveal >= scene().text.length; }\n\n  /**\n   * 整页的落点：处境一行、正文若干行、选项一行一个、末尾一行提示，\n   * **整块在纸上垂直居中**（一页排得好看的字，这是这个风格唯一的版面主张）。\n   * 几何一律按**整段正文**算，不按已经露出来的那几个字算 —— 否则字一边接上来页面一边跳。\n   */\n  function optRows(g) {\n    var L = layout(), sc = scene(), i;\n    serif(g, L.body);\n    var lines = wrap(g, sc.text, L.col);\n    var blockH = L.lead * 1.0                     // 处境\n      + L.lead * lines.length                     // 正文\n      + L.lead * 0.9                              // 正文与选项之间的留白\n      + L.lead * 1.15 * sc.opts.length            // 选项\n      + L.lead * 1.0;                             // 提示\n    var top = Math.max(L.pad, (H - blockH) / 2);\n    var bodyTop = top + L.lead * 1.9;\n    var optTop = bodyTop + L.lead * (lines.length - 1) + L.lead * 1.9;\n    var rows = [];\n    for (i = 0; i < sc.opts.length; i++) rows.push({ y: optTop + i * L.lead * 1.15, h: L.lead });\n    return { rows: rows, lines: lines, atY: top + L.lead * 0.8, bodyTop: bodyTop, L: L };\n  }\n\n  /** 结局屏的落点：标题 + 收尾一段 + 「这一夜你做过的事」逐条，同样整块居中。 */\n  function endRows(g) {\n    var L = layout(), end = ENDINGS[S.ending];\n    serif(g, L.body);\n    var lines = wrap(g, end.text, L.col);\n    var blockH = L.lead * 1.0 + L.lead * 1.5 + L.lead * lines.length\n      + L.lead * 1.4 + L.lead * 0.78 * (S.log.length + 2);\n    var top = Math.max(L.pad, (H - blockH) / 2);\n    return {\n      L: L, end: end, lines: lines,\n      dawnY: top + L.lead * 0.7,\n      titleY: top + L.lead * 1.9,\n      textTop: top + L.lead * 3.1,\n      logTop: top + L.lead * (3.1 + lines.length + 0.9)\n    };\n  }\n\n  function endingFor(tag) {\n    if (tag === \"ask\") {\n      if (S.e >= 5 && S.t >= 1) return \"signed\";\n      if (S.e >= 5) return \"doubted\";\n      return \"thin\";\n    }\n    if (tag === \"tell\") return S.e >= 5 ? \"without\" : \"thin\";\n    return \"silent\";\n  }\n\n  function choose(k) {\n    if (S.over || !ready()) return;\n    var sc = scene(), o = sc.opts[k];\n    if (!o) return;\n    S.acts++;\n    var d = o.d || {};\n    S.e += finite(d.e, 0);\n    S.t += finite(d.t, 0);\n    S.s += finite(d.s, 0);\n    S.log.push({ act: S.act, at: sc.at, text: o.text, d: { e: finite(d.e, 0), t: finite(d.t, 0), s: finite(d.s, 0) } });\n    S.act++;\n    if (S.s <= 0) { S.over = \"lose\"; S.ending = \"asleep\"; S.overAge = 0; return; }\n    if (o.to === \"end\") {\n      S.ending = endingFor(o.tag);\n      S.over = ENDINGS[S.ending].win ? \"win\" : \"lose\";\n      S.overAge = 0;\n      return;\n    }\n    S.scene = o.to;\n    S.trail.push(o.to);\n    S.reveal = 0;\n  }\n\n  return {\n    title: \"潮位站的一夜\",\n\n    setup: function (env) {\n      W = finite(env && env.width, 900);\n      H = finite(env && env.height, 620);\n      fresh();\n    },\n\n    resize: function (w, h) { W = finite(w, W); H = finite(h, H); },\n\n    pointer: function (x, y, phase) {\n      if (phase !== \"down\") return;\n      y = finite(y, -1);\n      if (S.over) { if (S.overAge > 420) fresh(); return; }\n      if (!ready()) { S.reveal = scene().text.length; return; }   // 点一下把这段话补齐，不是跳过\n      // 落点用**上一帧真画出来的那几行**，不另算一份：另算的那份与画出来的差半行，\n      // 用户就会点中隔壁的选项。\n      for (var i = 0; i < S.rows.length; i++) {\n        if (y >= S.rows[i] - S.rowH * 0.7 && y <= S.rows[i] + S.rowH * 0.35) {\n          choose(i);\n          return;\n        }\n      }\n    },\n\n    key: function (code, phase) {\n      if (phase !== \"down\") return;\n      if (S.over) {\n        if (code === \"Space\" || code === \"Enter\" || code === \" \") fresh();\n        return;\n      }\n      if (!ready()) { S.reveal = scene().text.length; return; }\n      if (code === \"Digit1\" || code === \"1\") choose(0);\n      else if (code === \"Digit2\" || code === \"2\") choose(1);\n      else if (code === \"Digit3\" || code === \"3\") choose(2);\n    },\n\n    // 正文一个字一个字接上来；读完就定住。除此之外没有任何东西在动。\n    update: function (dt) {\n      dt = finite(dt, 16.67);\n      if (S.over) { S.overAge += dt; return; }\n      var n = scene().text.length;\n      if (S.reveal < n) S.reveal = Math.min(n, S.reveal + dt / REVEAL_MS);\n    },\n\n    draw: function (g) {\n      var L = layout(), i;\n      g.fillStyle = rgba(PAPER, 1);\n      g.fillRect(0, 0, W, H);\n\n      g.textBaseline = \"alphabetic\";\n      g.textAlign = \"left\";\n\n      if (S.over) {\n        var e = endRows(g);\n        serif(g, L.small);\n        g.fillStyle = rgba(INK, 1);\n        g.globalAlpha = 0.5;\n        g.fillText(\"天亮了\", L.x, e.dawnY);\n        g.globalAlpha = 1;\n\n        serif(g, Math.min(W, H) * 0.05, \"700\");\n        g.fillStyle = rgba(e.end.win ? DONE : INK, 1);\n        g.fillText(e.end.title, L.x, e.titleY);\n\n        serif(g, L.body);\n        g.fillStyle = rgba(INK, 1);\n        g.globalAlpha = 0.9;\n        for (i = 0; i < e.lines.length; i++) g.fillText(e.lines[i], L.x, e.textTop + L.lead * i);\n        g.globalAlpha = 1;\n        return;\n      }\n\n      var sc = scene();\n      var page = optRows(g);\n      serif(g, L.small);\n      g.fillStyle = rgba(INK, 1);\n      g.globalAlpha = 0.45;\n      g.fillText(sc.at, L.x, page.atY);\n      g.globalAlpha = 1;\n\n      // 已经露出来的字：按整段的折行切，逐行给出去，页面不跳\n      serif(g, L.body);\n      var left = Math.floor(S.reveal);\n      g.fillStyle = rgba(INK, 1);\n      g.globalAlpha = 0.92;\n      for (i = 0; i < page.lines.length && left > 0; i++) {\n        var ln = page.lines[i];\n        g.fillText(left >= ln.length ? ln : ln.slice(0, left), L.x, page.bodyTop + L.lead * i);\n        left -= ln.length;\n      }\n      g.globalAlpha = 1;\n    },\n\n    hud: function (g) {\n      var L = layout(), i;\n\n      if (S.over) {\n        // 摊开账：这一局你走到这里，是因为前面这几步\n        var top = endRows(g).logTop;\n        serif(g, L.small, \"700\");\n        g.fillStyle = rgba(INK, 1);\n        g.globalAlpha = 0.75;\n        g.fillText(\"这一夜你做过的事\", L.x, top);\n        g.globalAlpha = 1;\n        serif(g, L.small);\n        for (i = 0; i < S.log.length; i++) {\n          var r = S.log[i];\n          var say = \"\";\n          if (r.d.e) say += (r.d.e > 0 ? \"把握 +\" : \"把握 \") + r.d.e + \"　\";\n          if (r.d.t) say += (r.d.t > 0 ? \"人情 +\" : \"人情 \") + r.d.t + \"　\";\n          if (r.d.s) say += (r.d.s > 0 ? \"精神 +\" : \"精神 \") + r.d.s;\n          if (!say) say = \"（这一步什么也没改变）\";\n          g.globalAlpha = 0.8;\n          g.fillStyle = rgba(INK, 1);\n          g.fillText(r.text, L.x, top + L.lead * 0.78 * (i + 1));\n          g.globalAlpha = 0.55;\n          g.fillStyle = rgba(TAP, 1);\n          g.textAlign = \"right\";\n          g.fillText(say, L.x + L.col, top + L.lead * 0.78 * (i + 1));\n          g.textAlign = \"left\";\n          g.globalAlpha = 1;\n        }\n        serif(g, L.small);\n        g.fillStyle = rgba(TAP, 1);\n        g.globalAlpha = 0.8;\n        g.fillText(\"按一下从头再来一夜\", L.x, top + L.lead * 0.78 * (S.log.length + 1.6));\n        g.globalAlpha = 1;\n        return;\n      }\n\n      if (!ready()) { S.rows = []; return; }      // 读完这一段才给选项\n\n      var probe = optRows(g);\n      S.rows = [];\n      S.rowH = L.lead;\n      for (i = 0; i < probe.rows.length; i++) S.rows.push(probe.rows[i].y);\n      serif(g, L.opt);\n      for (i = 0; i < probe.rows.length; i++) {\n        g.fillStyle = rgba(TAP, 1);\n        g.globalAlpha = 0.92;\n        g.fillText((i + 1) + \"　\" + scene().opts[i].text, L.x, probe.rows[i].y);\n        g.globalAlpha = 0.35;\n        g.strokeStyle = rgba(TAP, 1);\n        g.lineWidth = 1;\n        g.beginPath();\n        g.moveTo(L.x, probe.rows[i].y + L.lead * 0.22);\n        g.lineTo(L.x + L.col, probe.rows[i].y + L.lead * 0.22);\n        g.stroke();\n        g.globalAlpha = 1;\n      }\n      serif(g, L.small);\n      g.fillStyle = rgba(INK, 1);\n      g.globalAlpha = 0.4;\n      g.fillText(\"点一行，或按 1 / 2 / 3。想多久都行。\",\n        L.x, probe.rows[probe.rows.length - 1].y + L.lead * 1.3);\n      g.globalAlpha = 1;\n    },\n\n    __probe: function () {\n      return {\n        over: S.over, scene: S.scene, act: S.act, acts: S.acts,\n        ready: ready(), options: S.over ? 0 : scene().opts.length,\n        ending: S.ending,                         // 只有到了结局才有值\n        steps: S.log.length,\n        trail: S.trail.join(\">\"),                 // 这一局翻过的那几页（玩家自己看见的）\n        geom: { x: layout().x, col: layout().col, optY: S.rows.slice(), lead: layout().lead }\n      };\n    }\n  };\n})();\n\n\n(function () {\n  \"use strict\";\n  var cv = document.getElementById(\"stage\");\n  var g = cv.getContext(\"2d\", { alpha: false });\n  var W = 0, H = 0, started = false;\n\n  function fit() {\n    var dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = cv.clientWidth || window.innerWidth;\n    H = cv.clientHeight || window.innerHeight;\n    cv.width = Math.round(W * dpr);\n    cv.height = Math.round(H * dpr);\n    g.setTransform(dpr, 0, 0, dpr, 0, 0);\n    if (started && bundle.resize) bundle.resize(W, H);\n  }\n\n  fit();\n  bundle.setup({ ctx: g, canvas: cv, width: W, height: H });\n  started = true;\n  window.addEventListener(\"resize\", fit);\n  window.addEventListener(\"orientationchange\", fit);\n\n  function at(e) {\n    var r = cv.getBoundingClientRect();\n    return [e.clientX - r.left, e.clientY - r.top];\n  }\n  function on(name, phase) {\n    cv.addEventListener(name, function (e) {\n      var p = at(e);\n      bundle.pointer(p[0], p[1], phase);\n      if (e.cancelable) e.preventDefault();\n    }, { passive: false });\n  }\n  on(\"pointerdown\", \"down\");\n  on(\"pointermove\", \"move\");\n  on(\"pointerup\", \"up\");\n  cv.addEventListener(\"pointercancel\", function () { bundle.pointer(-1, -1, \"up\"); });\n  cv.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n\n  window.addEventListener(\"keydown\", function (e) {\n    if (e.repeat) return;\n    bundl