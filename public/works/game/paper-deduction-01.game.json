{
  "sourceFormat": "oceanleo.game-document.v1",
  "source": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<meta name=\"description\" content=\"一款只靠排除的推理小游戏：按行列线索推出哪些格是实心的，整盘不需要猜一格。\">\n<title>墨格</title>\n<style>\nhtml, body { margin: 0; padding: 0; height: 100%; background: #F6F1E6; overflow: hidden; }\nbody { touch-action: none; -webkit-user-select: none; user-select: none; }\n#stage { display: block; width: 100%; height: 100%; }\n#fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\n  font: 16px/1.7 system-ui, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  color: #fff; opacity: .75; text-align: center; padding: 2rem; }\n</style>\n</head>\n<body>\n<canvas id=\"stage\" role=\"img\" aria-label=\"一款只靠排除的推理小游戏：按行列线索推出哪些格是实心的，整盘不需要猜一格。\"></canvas>\n<noscript><div id=\"fallback\">这是一款需要 JavaScript 才能运行的小游戏：一款只靠排除的推理小游戏：按行列线索推出哪些格是实心的，整盘不需要猜一格。</div></noscript>\n<script>\n// 墨格 —— 玩法风格「纸上排除」（paper-deduction）\n// 循环：读一条线索 → 找到它唯一能落的地方 → 落墨锁死 → 这一步让另一条线索变唯一，回到读线索。\n// 难度只来自线索的交叉层数。没有计时器，没有随机，盘是设计出来的：\n// 这一盘（八行八列，实心 31 格）已用纯逐行逐列排除自验通过，整局任何一步都不需要猜。\nvar bundle = (function () {\n  \"use strict\";\n\n  // 盘面写死。'#' 是实心。出盘时用 line-solve 自验过「不猜一格可解」。\n  var PLAN = [\n    \"...##...\",\n    \"...##...\",\n    \".######.\",\n    \"...##...\",\n    \"#..##..#\",\n    \"#..##..#\",\n    \"#######.\",\n    \"..####..\"\n  ];\n  var ROWS = PLAN.length, COLS = PLAN[0].length;\n  var MISTAKES_MAX = 3;\n\n  // 一张暖白纸 + 一支墨 + 一支朱砂 + 一支比墨浅的铅（玩家自己的排除记号）。\n  var PAPER = [246, 241, 230], INK = [35, 32, 27], RED = [178, 58, 46], PENCIL = [167, 158, 140];\n  function rgba(c, a) { return \"rgba(\" + c[0] + \",\" + c[1] + \",\" + c[2] + \",\" + a + \")\"; }\n\n  var W = 0, H = 0, S = null, SOL = null, ROWC = null, COLC = null;\n\n  function finite(v, f) { return (typeof v === \"number\" && isFinite(v)) ? v : f; }\n\n  function runsOf(line) {\n    var out = [], n = 0, i;\n    for (i = 0; i < line.length; i++) {\n      if (line[i]) n++;\n      else if (n) { out.push(n); n = 0; }\n    }\n    if (n) out.push(n);\n    return out.length ? out : [0];\n  }\n\n  function bake() {\n    var r, c;\n    SOL = [];\n    for (r = 0; r < ROWS; r++) {\n      var row = [];\n      for (c = 0; c < COLS; c++) row.push(PLAN[r].charAt(c) === \"#\" ? 1 : 0);\n      SOL.push(row);\n    }\n    ROWC = [];\n    for (r = 0; r < ROWS; r++) ROWC.push(runsOf(SOL[r]));\n    COLC = [];\n    for (c = 0; c < COLS; c++) {\n      var col = [];\n      for (r = 0; r < ROWS; r++) col.push(SOL[r][c]);\n      COLC.push(runsOf(col));\n    }\n  }\n\n  function total() {\n    var n = 0, r, c;\n    for (r = 0; r < ROWS; r++) for (c = 0; c < COLS; c++) n += SOL[r][c];\n    return n;\n  }\n\n  // 0 未定 · 1 已落墨 · 2 打了排除记号 · 3 落错（朱砂，不可撤）\n  function fresh() {\n    var cells = [], i;\n    for (i = 0; i < ROWS * COLS; i++) cells.push(0);\n    S = {\n      cells: cells, mode: \"ink\", mistakes: 0, found: 0, need: total(),\n      last: -1, lastKind: \"\", cursor: 0, over: null, overAge: 0, acts: 0\n    };\n    return S;\n  }\n\n  function layout() {\n    var bar = Math.max(56, Math.min(H * 0.13, 92));\n    var pad = Math.max(14, Math.min(W, H) * 0.028);\n    var side = Math.min(W * 0.30, 268);              // 右栏：这一盘的规矩，常驻\n    var freeW = W - side - pad * 3;\n    var freeH = H - bar - pad * 2;\n    // 线索槽按三格宽算：这一盘最长的线索是三段。\n    var cell = Math.floor(Math.min(freeW / (COLS + 3), freeH / (ROWS + 3)));\n    var gutter = cell * 3;\n    var boardW = gutter + cell * COLS;\n    var boardH = gutter + cell * ROWS;\n    return {\n      bar: bar, pad: pad, cell: cell, gutter: gutter, side: side,\n      ox: pad + Math.max(0, (freeW - boardW) / 2),\n      oy: bar + pad + Math.max(0, (freeH - boardH) / 2),\n      sideX: W - side - pad, boardW: boardW, boardH: boardH\n    };\n  }\n\n  function gridAt(x, y) {\n    var L = layout();\n    var c = Math.floor((x - L.ox - L.gutter) / L.cell);\n    var r = Math.floor((y - L.oy - L.gutter) / L.cell);\n    if (r < 0 || r >= ROWS || c < 0 || c >= COLS) return -1;\n    return r * COLS + c;\n  }\n\n  function chipBox() {\n    var L = layout();\n    var h = Math.min(L.bar * 0.52, 34);\n    return { x: L.pad + Math.min(W * 0.22, 210), y: (L.bar - h) / 2, w: Math.min(W * 0.20, 176), h: h };\n  }\n\n  function rowDone(r) {\n    var c;\n    for (c = 0; c < COLS; c++) if (SOL[r][c] && S.cells[r * COLS + c] !== 1) return false;\n    return true;\n  }\n  function colDone(c) {\n    var r;\n    for (r = 0; r < ROWS; r++) if (SOL[r][c] && S.cells[r * COLS + c] !== 1) return false;\n    return true;\n  }\n\n  function place(i) {\n    if (S.over || i < 0) return;\n    var st = S.cells[i];\n    if (st === 1 || st === 3) return;               // 已定的格子不再动：盘面只往前收敛\n    var r = Math.floor(i / COLS), c = i % COLS;\n    if (S.mode === \"mark\") {\n      S.cells[i] = st === 2 ? 0 : 2;                // 排除记号是草稿，随便改，不判对错\n      S.last = i; S.lastKind = \"mark\"; S.acts++;\n      return;\n    }\n    S.acts++;\n    S.last = i;\n    if (SOL[r][c]) {\n      S.cells[i] = 1; S.lastKind = \"ink\"; S.found++;\n      if (S.found >= S.need) { S.over = \"win\"; S.overAge = 0; }\n    } else {\n      S.cells[i] = 3; S.lastKind = \"wrong\"; S.mistakes++;\n      if (S.mistakes >= MISTAKES_MAX) { S.over = \"lose\"; S.overAge = 0; }\n    }\n  }\n\n  function serif(g, px, weight) {\n    g.font = (weight ? weight + \" \" : \"\") + Math.round(px) +\n      \"px 'Noto Sans CJK SC', system-ui, -apple-system, 'PingFang SC', sans-serif\";\n  }\n\n  return {\n    title: \"墨格\",\n\n    setup: function (env) {\n      W = finite(env && env.width, 900);\n      H = finite(env && env.height, 620);\n      bake();\n      fresh();\n    },\n\n    resize: function (w, h) { W = finite(w, W); H = finite(h, H); },\n\n    pointer: function (x, y, phase) {\n      if (phase !== \"down\") return;\n      x = finite(x, -1); y = finite(y, -1);\n      if (S.over) {\n        if (S.overAge > 420) { fresh(); }\n        return;\n      }\n      var b = chipBox();\n      if (x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h) {\n        S.mode = S.mode === \"ink\" ? \"mark\" : \"ink\";\n        return;\n      }\n      var i = gridAt(x, y);\n      if (i >= 0) { S.cursor = i; place(i); }\n    },\n\n    key: function (code, phase) {\n      if (phase !== \"down\") return;\n      if (S.over) {\n        if (code === \"Space\" || code === \"Enter\" || code === \" \") fresh();\n        return;\n      }\n      var r = Math.floor(S.cursor / COLS), c = S.cursor % COLS;\n      if (code === \"ArrowLeft\") { S.cursor = r * COLS + Math.max(0, c - 1); return; }\n      if (code === \"ArrowRight\") { S.cursor = r * COLS + Math.min(COLS - 1, c + 1); return; }\n      if (code === \"ArrowUp\") { S.cursor = Math.max(0, r - 1) * COLS + c; return; }\n      if (code === \"ArrowDown\") { S.cursor = Math.min(ROWS - 1, r + 1) * COLS + c; return; }\n      if (code === \"Enter\" || code === \"KeyX\") { place(S.cursor); return; }\n      if (code === \"Space\" || code === \"KeyM\" || code === \" \") S.mode = S.mode === \"ink\" ? \"mark\" : \"ink\";\n    },\n\n    // 手不动，盘面一格都不变。这里只推「结算画面停留了多久」这一个计时器。\n    update: function (dt) {\n      dt = finite(dt, 16.67);\n      if (S.over) S.overAge += dt;\n    },\n\n    draw: function (g) {\n      var L = layout(), r, c, i, x, y;\n\n      g.fillStyle = rgba(PAPER, 1);\n      g.fillRect(0, 0, W, H);\n\n      // 线索槽底：比纸略深一点点，靠透明度做，不引第五个颜色\n      g.globalAlpha = 0.05;\n      g.fillStyle = rgba(INK, 1);\n      g.fillRect(L.ox, L.oy, L.gutter, L.boardH);\n      g.fillRect(L.ox + L.gutter, L.oy, L.boardW - L.gutter, L.gutter);\n      g.globalAlpha = 1;\n\n      // 格线：四格一道粗线，帮眼睛数格\n      for (i = 0; i <= COLS; i++) {\n        x = L.ox + L.gutter + i * L.cell;\n        g.globalAlpha = i % 4 === 0 ? 0.55 : 0.20;\n        g.lineWidth = i % 4 === 0 ? 2 : 1;\n        g.strokeStyle = rgba(INK, 1);\n        g.beginPath(); g.moveTo(x, L.oy); g.lineTo(x, L.oy + L.boardH); g.stroke();\n      }\n      for (i = 0; i <= ROWS; i++) {\n        y = L.oy + L.gutter + i * L.cell;\n        g.globalAlpha = i % 4 === 0 ? 0.55 : 0.20;\n        g.lineWidth = i % 4 === 0 ? 2 : 1;\n        g.strokeStyle = rgba(INK, 1);\n        g.beginPath(); g.moveTo(L.ox, y); g.lineTo(L.ox + L.boardW, y); g.stroke();\n      }\n      g.globalAlpha = 1;\n      g.lineWidth = 1;\n\n      // 线索：整条线推完之后自己变淡 —— 这是这一件唯一的「做对了」反馈\n      serif(g, L.cell * 0.44, \"600\");\n      g.fillStyle = rgba(INK, 1);\n      g.textBaseline = \"middle\";\n      for (r = 0; r < ROWS; r++) {\n        g.globalAlpha = rowDone(r) ? 0.28 : 0.92;\n        g.textAlign = \"right\";\n        var rt = ROWC[r].join(\" \");\n        g.fillText(rt, L.ox + L.gutter - L.cell * 0.28, L.oy + L.gutter + r * L.cell + L.cell / 2);\n      }\n      for (c = 0; c < COLS; c++) {\n        g.globalAlpha = colDone(c) ? 0.28 : 0.92;\n        g.textAlign = \"center\";\n        var cl = COLC[c];\n        for (i = 0; i < cl.length; i++) {\n          g.fillText(String(cl[i]),\n            L.ox + L.gutter + c * L.cell + L.cell / 2,\n            L.oy + L.gutter - L.cell * (cl.length - i) + L.cell * 0.5);\n        }\n      }\n      g.globalAlpha = 1;\n\n      // 格子本身\n      for (r = 0; r < ROWS; r++) {\n        for (c = 0; c < COLS; c++) {\n          i = r * COLS + c;\n          x = L.ox + L.gutter + c * L.cell;\n          y = L.oy + L.gutter + r * L.cell;\n          var st = S.cells[i];\n          if (st === 1) {\n            g.globalAlpha = 0.94;\n            g.fillStyle = rgba(INK, 1);\n            g.fillRect(x + 1.5, y + 1.5, L.cell - 3, L.cell - 3);\n          } else if (st === 2) {\n            g.globalAlpha = 0.85;\n            g.strokeStyle = rgba(PENCIL, 1);\n            g.lineWidth = Math.max(1.5, L.cell * 0.06);\n            g.beginPath();\n            g.moveTo(x + L.cell * 0.34, y + L.cell * 0.34);\n            g.lineTo(x + L.cell * 0.66, y + L.cell * 0.66);\n            g.moveTo(x + L.cell * 0.66, y + L.cell * 0.34);\n            g.lineTo(x + L.cell * 0.34, y + L.cell * 0.66);\n            g.stroke();\n          } else if (st === 3) {\n            g.globalAlpha = 0.9;\n            g.strokeStyle = rgba(RED, 1);\n            g.lineWidth = Math.max(2, L.cell * 0.09);\n            g.beginPath();\n            g.moveTo(x + L.cell * 0.26, y + L.cell * 0.26);\n            g.lineTo(x + L.cell * 0.74, y + L.cell * 0.74);\n            g.moveTo(x + L.cell * 0.74, y + L.cell * 0.26);\n            g.lineTo(x + L.cell * 0.26, y + L.cell * 0.74);\n            g.stroke();\n          }\n          g.globalAlpha = 1;\n        }\n      }\n\n      // 键盘光标：不用 hover，也能看见方向键下一次会落在哪一格。\n      if (!S.over) {\n        x = L.ox + L.gutter + (S.cursor % COLS) * L.cell;\n        y = L.oy + L.gutter + Math.floor(S.cursor / COLS) * L.cell;\n        g.globalAlpha = 0.78;\n        g.strokeStyle = rgba(RED, 1);\n        g.lineWidth = Math.max(2, L.cell * 0.07);\n        g.strokeRect(x + 2.5, y + 2.5, L.cell - 5, L.cell - 5);\n        g.globalAlpha = 1;\n      }\n\n      // 输了才揭答案：没找到的实心格用铅笔轮廓补出来，让人看见自己差在哪\n      if (S.over === \"lose\") {\n        g.globalAlpha = 0.5;\n        g.strokeStyle = rgba(PENCIL, 1);\n        g.lineWidth = Math.max(1.5, L.cell * 0.07);\n        for (r = 0; r < ROWS; r++) {\n          for (c = 0; c < COLS; c++) {\n            if (SOL[r][c] && S.cells[r * COLS + c] !== 1) {\n              g.strokeRect(L.ox + L.gutter + c * L.cell + 3, L.oy + L.gutter + r * L.cell + 3,\n                L.cell - 6, L.cell - 6);\n            }\n          }\n        }\n        g.globalAlpha = 1;\n      }\n      g.lineWidth = 1;\n    },\n\n    hud: function (g) {\n      var L = layout(), i;\n\n      // 顶栏\n      g.globalAlpha = 0.06;\n      g.fillStyle = rgba(INK, 1);\n      g.fillRect(0, 0, W, L.bar);\n      g.globalAlpha = 0.45;\n      g.strokeStyle = rgba(INK, 1);\n      g.beginPath(); g.moveTo(0, L.bar); g.lineTo(W, L.bar); g.stroke();\n      g.globalAlpha = 1;\n\n      g.textBaseline = \"middle\";\n      g.textAlign = \"left\";\n      serif(g, Math.min(W, H) * 0.042, \"700\");\n      g.fillStyle = rgba(INK, 1);\n      g.fillText(\"墨格\", L.pad, L.bar / 2);\n\n      // 模式牌：落墨 / 打叉，点它或按空格换\n      var b = chipBox();\n      g.globalAlpha = S.mode === \"ink\" ? 0.9 : 0.55;\n      g.strokeStyle = rgba(INK, 1);\n      g.lineWidth = 1.5;\n      g.strokeRect(b.x, b.y, b.w, b.h);\n      g.globalAlpha = 1;\n      serif(g, b.h * 0.5);\n      g.textAlign = \"center\";\n      g.fillStyle = rgba(S.mode === \"ink\" ? INK : PENCIL, 1);\n      g.fillText(S.mode === \"ink\" ? \"落墨（空格换）\" : \"打叉（空格换）\", b.x + b.w / 2, b.y + b.h / 2);\n\n      // 右上：还剩几格 + 错几次\n      g.textAlign = \"right\";\n      serif(g, Math.min(W, H) * 0.032);\n      g.fillStyle = rgba(INK, 1);\n      g.globalAlpha = 0.8;\n      g.fillText(\"还剩 \" + (S.need - S.found) + \" 格\", W - L.pad, L.bar * 0.34);\n      g.globalAlpha = 1;\n      var dots = \"\";\n      for (i = 0; i < MISTAKES_MAX; i++) dots += i < S.mistakes ? \"×\" : \"·\";\n      g.fillStyle = rgba(S.mistakes ? RED : INK, 1);\n      g.globalAlpha = S.mistakes ? 0.95 : 0.55;\n      g.fillText(\"错 \" + dots, W - L.pad, L.bar * 0.72);\n      g.globalAlpha = 1;\n\n      // 右栏：这一盘的规矩，常驻不动\n      var sx = L.sideX, sy = L.bar + L.pad * 1.6;\n      var lh = Math.min(W, H) * 0.046;\n      serif(g, Math.min(W, H) * 0.03, \"700\");\n      g.textAlign = \"left\";\n      g.fillStyle = rgba(INK, 1);\n      g.fillText(\"怎么推\", sx, sy);\n      serif(g, Math.min(W, H) * 0.026);\n      g.globalAlpha = 0.78;\n      var lines = [\n        \"行列外的数字是那条线上\",\n        \"连续实心格的长度，按顺序排。\",\n        \"先找一眼能定死的长线索，\",\n        \"定下来的格子再去卡别的线索。\",\n        \"\",\n        \"落墨：确定是实心的格。\",\n        \"打叉：确定是空的格（草稿，\",\n        \"随便改，不算错）。\",\n        \"\",\n        \"方向键移格，回车落下；\",\n        \"也可以直接点任意格。\",\n        \"落错三次这一局到此为止。\",\n        \"没有计时器，想多久都行。\"\n      ];\n      for (i = 0; i < lines.length; i++) g.fillText(lines[i], sx, sy + lh * (i + 1.15));\n      g.globalAlpha = 1;\n\n      // 结算：只用一行字，不弹窗、不盖住盘面\n      if (S.over) {\n        var msg = S.over === \"win\"\n          ? \"推完了　\" + (MISTAKES_MAX - S.mistakes) + \" 次容错没用完\"\n          : \"错满三次　浅框是你没找到的实心格\";\n        g.globalAlpha = 0.1;\n        g.fillStyle = rgba(INK, 1);\n        g.fillRect(0, H - L.pad * 3.2, W, L.pad * 3.2);\n        g.globalAlpha = 1;\n        serif(g, Math.min(W, H) * 0.034, \"600\");\n        g.textAlign = \"center\";\n        g.fillStyle = rgba(S.over === \"win\" ? INK : RED, 1);\n        g.fillText(msg + \"　·　按一下再来\", W / 2, H - L.pad * 1.6);\n      }\n    },\n\n    __probe: function () {\n      var L = layout();\n      return {\n        over: S.over, mode: S.mode, mistakes: S.mistakes, mistakesMax: MISTAKES_MAX,\n        found: S.found, need: S.need, left: S.need - S.found, acts: S.acts,\n        cursor: S.cursor,\n        rows: ROWS, cols: COLS,\n        cells: S.cells.slice(),          // 屏上看得见的东西：哪些格已定、哪些打了叉\n        rowClues: ROWC, colClues: COLC,  // 屏上印着的线索\n        geom: { ox: L.ox + L.gutter, oy: L.oy + L.gutter, cell: L.cell, chip: chipBox() }\n      };\n    }\n  };\n})();\n\n\n(function () {\n  \"use strict\";\n  var cv = document.getElementById(\"stage\");\n  var g = cv.getContext(\"2d\", { alpha: false });\n  var W = 0, H = 0, started = false;\n\n  function fit() {\n    var dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = cv.clientWidth || window.innerWidth;\n    H = cv.clientHeight || window.innerHeight;\n    cv.width = Math.round(W * dpr);\n    cv.height = Math.round(H * dpr);\n    g.setTransform(dpr, 0, 0, dpr, 0, 0);\n    if (started && bundle.resize) bundle.resize(W, H);\n  }\n\n  fit();\n  bundle.setup({ ctx: g, canvas: cv, width: W, height: H });\n  started = true;\n  window.addEventListener(\"resize\", fit);\n  window.addEventListener(\"orientationchange\", fit);\n\n  function at(e) {\n    var r = cv.getBoundingClientRect();\n    return [e.clientX - r.left, e.clientY - r.top];\n  }\n  function on(name, phase) {\n    cv.addEventListener(name, function (e) {\n      var p = at(e);\n      bundle.pointer(p[0], p[1], phase);\n      if (e.cancelable) e.preventDefault();\n    }, { passive: false });\n  }\n  on(\"pointerdown\", \"down\");\n  on(\"pointermove\", \"move\");\n  on(\"pointerup\", \"up\");\n  cv.addEventListener(\"pointercancel\", function () { bundle.pointer(-1, -1, \"up\"); });\n  cv.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n\n  window.addEventListener(\"keydown\", function (e) {\n    if (e.repeat) return;\n    bundle.key(e.code || e.key, \"down\");\n    if (e.code === \"Space\" || e.code === \"ArrowUp\" || e.code === \"ArrowDown\") e.preventDefault();\n  });\n  window.addEventListener(\"keyup\", function (e) { bundle.key(e.code || e.key, \"up\"); });\n\n  var last = 0;\n  function loop(ts) {\n    var dt = last ? Math.min(ts - last, 50) : 16.67;\n    last = ts;\n    bundle.update(dt, ts);\n    bundle.draw(g, ts);\n    bundle.hud(g, ts);\n    window.requestAnimationFrame(loop);\n  }\n  window.requestAnimationFrame(loop);\n})();\n\n</script>\n</body>\n</html>",
  "sizeBytes": 18088,
  "origin": "ai",
  "manifest": {
    "title": "墨格",
    "summary": "八行八列，格子外面印着每行每列实心格的长度。先找一眼能定死的长线索，定下来的格子再去卡别的线索，一格一格把图推出来。落错三次到此为止，没有计时器。",
    "tags": [
      "游戏",
      "推理解谜",
      "线索",
      "纸面"
    ],
    "credits": "OceanLeo (OCEANLEO-AIGEN)"
  }
}
