{
  "sourceFormat": "oceanleo.game-document.v1",
  "source": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<meta name=\"description\" content=\"一款只有一个动作的反应小游戏：指针进门时按下，门越来越窄。\">\n<title>潮汐门</title>\n<style>\nhtml, body { margin: 0; padding: 0; height: 100%; background: #04121f; overflow: hidden; }\nbody { touch-action: none; -webkit-user-select: none; user-select: none; }\n#stage { display: block; width: 100%; height: 100%; }\n#fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\n  font: 16px/1.7 system-ui, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  color: #fff; opacity: .75; text-align: center; padding: 2rem; }\n</style>\n</head>\n<body>\n<canvas id=\"stage\" role=\"img\" aria-label=\"一款只有一个动作的反应小游戏：指针进门时按下，门越来越窄。\"></canvas>\n<noscript><div id=\"fallback\">这是一款需要 JavaScript 才能运行的小游戏：一款只有一个动作的反应小游戏：指针进门时按下，门越来越窄。</div></noscript>\n<script>\n// 潮汐门 —— 玩法风格「一息」（one-breath-reflex）\n// 循环：看到时机收窄 → 按下唯一那个动作 → 当场知道准还是偏 → 更快，回到看时机。\n// 难度只来自反应。三色：深底 / 行动青 / 警告红。\nvar bundle = (function () {\n  \"use strict\";\n\n  // ── 手感常量表（全部集中在这里，逻辑里不许再出现字面量）────────────────\n  var K = {\n    lives: 3,             // 命数\n    target: 28,           // 过关所需命中数\n    speed0: 0.0016,       // 初始角速度（弧度/毫秒）\n    speedUp: 1.045,       // 每命中一次的提速倍率\n    speedMax: 0.0052,     // 角速度上限\n    span0: 0.74,          // 初始门宽（弧度）\n    spanShrink: 0.955,    // 每命中一次的门宽收窄倍率\n    spanMin: 0.20,        // 门宽下限（留给玩家的容错底线）\n    // 新门离当前指针多远。**leadMin + leadVar 必须小于一整圈减去门宽**：\n    // 超过一圈会绕回来，新门就贴在指针脸上，玩家还没看清就已经错过。\n    leadMin: 3.0,\n    leadVar: 3.0,\n    flipEvery: 3,         // 每几次命中翻一次转向\n    lockMs: 150,          // 按下判定的锁定时间，防手指连点\n    overQuietMs: 250,     // 结算画面的静默期，之后按一下即重开\n    titleMs: 1500,        // 标题字退场时间\n    flashMs: 260,         // 判定闪光时长\n    shakeMs: 200,         // 失手轻震时长\n    shakeMax: 7,          // 轻震最大位移（像素）\n    dots: 44,             // 表盘刻点数\n    demoRestartMs: 1100   // 演示模式下终局后自动重开的间隔\n  };\n\n  var BASE = [4, 18, 31], ACT = [49, 230, 196], WARN = [255, 85, 102];\n  function rgba(c, a) { return \"rgba(\" + c[0] + \",\" + c[1] + \",\" + c[2] + \",\" + a + \")\"; }\n\n  var TAU = Math.PI * 2;\n  function norm(a) { a = a % TAU; return a < 0 ? a + TAU : a; }\n  function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }\n  function finite(v, fallback) { return (typeof v === \"number\" && isFinite(v)) ? v : fallback; }\n\n  var S = null, W = 0, H = 0;\n\n  // 定种子随机：封面要求同一份输入产出逐字节相同的 PNG，所以不许用 Math.random。\n  function rnd() {\n    S.seed = (S.seed * 1664525 + 1013904223) % 4294967296;\n    return S.seed / 4294967296;\n  }\n\n  function fresh(demo) {\n    return {\n      seed: 20260813,\n      ang: 0, dir: 1,\n      speed: K.speed0, span: K.span0, gate: Math.PI * 0.75,\n      hits: 0, lives: K.lives, over: null,\n      inGate: false, used: false,\n      lock: 0, flash: 0, flashKind: \"hit\", shake: 0,\n      age: 0, ripples: [], demo: demo, overAge: 0\n    };\n  }\n\n  function layout() {\n    var band = clamp(H * 0.13, 52, 96);\n    var cx = W / 2;\n    var cy = (H - band) / 2;\n    var r = Math.min(W, H - band) * 0.36;\n    return { band: band, cx: cx, cy: cy, r: r, bandTop: H - band };\n  }\n\n  function placeGate() {\n    S.gate = norm(S.ang + S.dir * (K.leadMin + rnd() * K.leadVar) - (S.dir < 0 ? S.span : 0));\n    S.inGate = false;\n    S.used = false;\n  }\n\n  function ripple(kind) {\n    var L = layout();\n    S.ripples.push({\n      x: L.cx + Math.cos(S.ang) * L.r,\n      y: L.cy + Math.sin(S.ang) * L.r,\n      age: 0, kind: kind\n    });\n    if (S.ripples.length > 8) S.ripples.shift();\n  }\n\n  function hurt() {\n    S.lives -= 1;\n    S.flash = K.flashMs;\n    S.flashKind = \"miss\";\n    S.shake = K.shakeMs;\n    if (S.lives <= 0) { S.lives = 0; S.over = \"lose\"; S.overAge = 0; }\n  }\n\n  function press() {\n    // 重开不受连点锁约束：结算画面上按下去必须立刻回到新的一局。\n    // 只留一个极短的静默期，免得终结那一下的余劲把结果直接翻页。\n    if (S.over) {\n      if (S.overAge < K.overQuietMs) return;\n      S = fresh(S.demo);\n      placeGate();\n      return;\n    }\n    // 连点锁只挡无效的按。挡住一次真命中，玩家会觉得「我明明按中了」——\n    // 那是判定在骗人，比连点严重得多。\n    var into = norm(S.ang - S.gate);\n    var valid = into < S.span && !S.used;\n    if (!valid && S.lock > 0) return;\n    S.lock = K.lockMs;\n    if (valid) {\n      S.used = true;\n      S.hits += 1;\n      S.flash = K.flashMs;\n      S.flashKind = \"hit\";\n      ripple(\"hit\");\n      if (S.hits >= K.target) { S.over = \"win\"; S.overAge = 0; return; }\n      S.speed = Math.min(S.speed * K.speedUp, K.speedMax);\n      S.span = Math.max(S.span * K.spanShrink, K.spanMin);\n      if (S.hits % K.flipEvery === 0) S.dir = -S.dir;\n      placeGate();\n    } else {\n      ripple(\"miss\");\n      hurt();\n    }\n  }\n\n  return {\n    title: \"潮汐门\",\n\n    setup: function (env) {\n      W = finite(env && env.width, 640);\n      H = finite(env && env.height, 640);\n      S = fresh(true);\n      placeGate();\n    },\n\n    resize: function (w, h) {\n      W = finite(w, W);\n      H = finite(h, H);\n    },\n\n    pointer: function (x, y, phase) {\n      if (phase !== \"down\") return;\n      S.demo = false;\n      press();\n    },\n\n    key: function (code, phase) {\n      if (phase !== \"down\") return;\n      if (code === \"Space\" || code === \"Enter\" || code === \" \" || code === \"KeyJ\") {\n        S.demo = false;\n        press();\n      }\n    },\n\n    update: function (dt, t) {\n      dt = clamp(finite(dt, 16.67), 0, 50);\n      S.age += dt;\n      S.lock = Math.max(0, S.lock - dt);\n      S.flash = Math.max(0, S.flash - dt);\n      S.shake = Math.max(0, S.shake - dt);\n      for (var i = 0; i < S.ripples.length; i++) S.ripples[i].age += dt;\n      while (S.ripples.length && S.ripples[0].age > 620) S.ripples.shift();\n\n      if (S.over) {\n        S.overAge += dt;\n        if (S.demo && S.overAge > K.demoRestartMs) { S = fresh(true); placeGate(); }\n        return;\n      }\n\n      S.ang = norm(S.ang + S.dir * S.speed * dt);\n\n      // 演示：没有人碰过它的时候自己玩给人看，第一次真输入就交还给玩家。\n      // 必须在算 now 之前按 —— 按中会把门挪走，拿旧门算出来的 now 会让下一帧\n      // 误判成「门从眼前过去了没按」，等于每命中一次就白扣一条命。\n      var into = norm(S.ang - S.gate);\n      if (S.demo && into < S.span && !S.used && into > S.span * 0.45) press();\n\n      var now = norm(S.ang - S.gate) < S.span;\n      if (S.inGate && !now && !S.used) {\n        // 门从眼前过去了却没按 —— 放着不管必须死。\n        hurt();\n        if (!S.over) placeGate();\n      }\n      S.inGate = now;\n    },\n\n    draw: function (g, t) {\n      var L = layout();\n      var sh = 0;\n      if (S.shake > 0) {\n        sh = (S.shake / K.shakeMs) * K.shakeMax;\n        sh = Math.sin(S.age * 0.09) * sh;\n      }\n\n      g.fillStyle = rgba(BASE, 1);\n      g.fillRect(0, 0, W, H);\n\n      g.save();\n      g.translate(sh, 0);\n\n      var dim = S.over ? 0.25 : 1;\n\n      // 表盘：一圈刻点。离门越近越亮，玩家因此能看出「还差多少」。\n      for (var i = 0; i < K.dots; i++) {\n        var a = (i / K.dots) * TAU;\n        var into = norm(a - S.gate);\n        var lit = into < S.span;\n        var d = Math.abs(norm(a - S.ang + Math.PI) - Math.PI);\n        var near = clamp(1 - d / 0.9, 0, 1);\n        var rr = L.r + (lit ? 0 : 0);\n        var size = Math.max(1.6, L.r * (lit ? 0.032 : 0.017) * (1 + near * 0.7));\n        g.beginPath();\n        g.arc(L.cx + Math.cos(a) * rr, L.cy + Math.sin(a) * rr, size, 0, TAU);\n        g.fillStyle = rgba(lit ? ACT : ACT, (lit ? 0.95 : 0.16 + near * 0.3) * dim);\n        g.fill();\n      }\n\n      // 门：那道弧就是「现在可以按」，行动色只出现在这里。\n      g.beginPath();\n      g.arc(L.cx, L.cy, L.r, S.gate, S.gate + S.span);\n      g.strokeStyle = rgba(ACT, 0.9 * dim);\n      g.lineWidth = Math.max(3, L.r * 0.055);\n      g.lineCap = \"round\";\n      g.stroke();\n\n      // 指针\n      var hx = L.cx + Math.cos(S.ang) * L.r;\n      var hy = L.cy + Math.sin(S.ang) * L.r;\n      g.beginPath();\n      g.moveTo(L.cx + Math.cos(S.ang) * L.r * 0.22, L.cy + Math.sin(S.ang) * L.r * 0.22);\n      g.lineTo(hx, hy);\n      g.strokeStyle = rgba(ACT, 0.55 * dim);\n      g.lineWidth = Math.max(1.5, L.r * 0.018);\n      g.stroke();\n\n      g.beginPath();\n      g.arc(hx, hy, Math.max(4, L.r * 0.075), 0, TAU);\n      g.fillStyle = S.flash > 0 && S.flashKind === \"miss\" ? rgba(WARN, dim) : rgba(ACT, dim);\n      g.fill();\n\n      // 判定回响：短、猛、退得干净，绝不盖住下一个时机。\n      for (var j = 0; j < S.ripples.length; j++) {\n        var p = S.ripples[j];\n        var k = clamp(p.age / 620, 0, 1);\n        g.beginPath();\n        g.arc(p.x, p.y, L.r * (0.09 + k * 0.42), 0, TAU);\n        g.strokeStyle = rgba(p.kind === \"hit\" ? ACT : WARN, (1 - k) * 0.75);\n        g.lineWidth = Math.max(1.5, L.r * 0.022 * (1 - k));\n        g.stroke();\n      }\n\n      // 盘心：开局一秒半是作品名，之后一直是命中数。不做开场页，加载完就在玩。\n      var tf = clamp(1 - (S.age - K.titleMs) / 500, 0, 1);\n      g.textAlign = \"center\";\n      g.textBaseline = \"middle\";\n      if (S.over) {\n        g.font = \"600 \" + Math.round(L.r * 0.34) + \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n        g.fillStyle = rgba(S.over === \"win\" ? ACT : WARN, 1);\n        g.fillText(S.over === \"win\" ? \"过关\" : \"结束\", L.cx, L.cy - L.r * 0.1);\n        g.font = Math.round(L.r * 0.13) + \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n        g.fillStyle = rgba(ACT, 0.8);\n        g.fillText(\"命中 \" + S.hits + \" / \" + K.target + \"　按一下再来一局\", L.cx, L.cy + L.r * 0.28);\n      } else if (S.age < K.titleMs + 500) {\n        g.font = \"600 \" + Math.round(L.r * 0.3) + \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n        g.fillStyle = rgba(ACT, tf);\n        g.fillText(\"潮汐门\", L.cx, L.cy - L.r * 0.06);\n        g.font = Math.round(L.r * 0.12) + \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n        g.fillStyle = rgba(ACT, tf * 0.65);\n        g.fillText(\"指针进门时按下\", L.cx, L.cy + L.r * 0.24);\n      } else {\n        g.font = \"600 \" + Math.round(L.r * 0.52) + \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n        g.fillStyle = rgba(S.flash > 0 && S.flashKind === \"hit\" ? ACT : ACT, S.flash > 0 ? 1 : 0.82);\n        g.fillText(String(S.hits), L.cx, L.cy);\n      }\n\n      g.restore();\n    },\n\n    hud: function (g, t) {\n      var L = layout();\n\n      g.beginPath();\n      g.moveTo(W * 0.08, L.bandTop);\n      g.lineTo(W * 0.92, L.bandTop);\n      g.strokeStyle = rgba(ACT, 0.18);\n      g.lineWidth = 1;\n      g.stroke();\n\n      var cy = L.bandTop + L.band * 0.52;\n      var r = Math.max(4, L.band * 0.11);\n      for (var i = 0; i < K.lives; i++) {\n        g.beginPath();\n        g.arc(W * 0.08 + r + i * r * 3.2, cy, r, 0, Math.PI * 2);\n        if (i < S.lives) { g.fillStyle = rgba(WARN, 0.9); g.fill(); }\n        else { g.strokeStyle = rgba(WARN, 0.35); g.lineWidth = 1.5; g.stroke(); }\n      }\n\n      g.font = Math.round(L.band * 0.26) + \"px system-ui, -apple-system, 'PingFang SC', sans-serif\";\n      g.textBaseline = \"middle\";\n      g.textAlign = \"center\";\n      g.fillStyle = rgba(ACT, 0.5);\n      g.fillText(S.over ? \"按一下 · 重开\" : \"按下 / 空格\", W * 0.5, cy);\n\n      g.textAlign = \"right\";\n      g.fillStyle = rgba(ACT, 0.75);\n      g.fillText(S.hits + \" / \" + K.target, W * 0.92, cy);\n    },\n\n    // 自证接口：无浏览器条件下的逻辑单测靠它读状态，不参与画面。\n    __probe: function () {\n      return {\n        hits: S.hits, lives: S.lives, over: S.over, span: S.span,\n        speed: S.speed, demo: S.demo, ang: S.ang, gate: S.gate, dir: S.dir\n      };\n    }\n  };\n})();\n\n\n(function () {\n  \"use strict\";\n  var cv = document.getElementById(\"stage\");\n  var g = cv.getContext(\"2d\", { alpha: false });\n  var W = 0, H = 0, started = false;\n\n  function fit() {\n    var dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = cv.clientWidth || window.innerWidth;\n    H = cv.clientHeight || window.innerHeight;\n    cv.width = Math.round(W * dpr);\n    cv.height = Math.round(H * dpr);\n    g.setTransform(dpr, 0, 0, dpr, 0, 0);\n    if (started && bundle.resize) bundle.resize(W, H);\n  }\n\n  fit();\n  bundle.setup({ ctx: g, canvas: cv, width: W, height: H });\n  started = true;\n  window.addEventListener(\"resize\", fit);\n  window.addEventListener(\"orientationchange\", fit);\n\n  function at(e) {\n    var r = cv.getBoundingClientRect();\n    return [e.clientX - r.left, e.clientY - r.top];\n  }\n  function on(name, phase) {\n    cv.addEventListener(name, function (e) {\n      var p = at(e);\n      bundle.pointer(p[0], p[1], phase);\n      if (e.cancelable) e.preventDefault();\n    }, { passive: false });\n  }\n  on(\"pointerdown\", \"down\");\n  on(\"pointermove\", \"move\");\n  on(\"pointerup\", \"up\");\n  cv.addEventListener(\"pointercancel\", function () { bundle.pointer(-1, -1, \"up\"); });\n  cv.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n\n  window.addEventListener(\"keydown\", function (e) {\n    if (e.repeat) return;\n    bundle.key(e.code || e.key, \"down\");\n    if (e.code === \"Space\" || e.code === \"ArrowUp\" || e.code === \"ArrowDown\") e.preventDefault();\n  });\n  window.addEventListener(\"keyup\", function (e) { bundle.key(e.code || e.key, \"up\"); });\n\n  var last = 0;\n  function loop(ts) {\n    var dt = last ? Math.min(ts - last, 50) : 16.67;\n    last = ts;\n    bundle.update(dt, ts);\n    bundle.draw(g, ts);\n    bundle.hud(g, ts);\n    window.requestAnimationFrame(loop);\n  }\n  window.requestAnimationFrame(loop);\n})();\n\n</script>\n</body>\n</html>",
  "sizeBytes": 14738,
  "origin": "ai",
  "manifest": {
    "title": "潮汐门",
    "summary": "指针绕盘一圈，进门那一瞬按下。门每中一次就更窄更快，三条命，中满二十八次过关。",
    "tags": [
      "游戏",
      "反应",
      "极简",
      "单键"
    ],
    "credits": "OceanLeo (OCEANLEO-AIGEN)"
  }
}
