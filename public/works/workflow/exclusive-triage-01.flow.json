{
  "schema": "oceanleo.workflow-view/v1",
  "note": "站内查看数据逐条投影自 project；params 与 theme 均保留，查看器不得用默认色覆盖调用方合法输入。",
  "project": "oceanleo.video-canvas.v1",
  "theme": {
    "surface": "#F3EBDD",
    "node": "#FFF9EE",
    "nodeBorder": "#2F6B57",
    "text": "#173B32",
    "muted": "#6B5D4D",
    "edge": "#2F6B57",
    "accent": "#D66A2C",
    "warning": "#B3261E"
  },
  "nodes": [
    {
      "id": "n-intake",
      "label": "受理 · 工单入口",
      "kind": "source",
      "x": 56,
      "y": 172,
      "assetId": "assets/audio/sfx/freesound-514833.mp3",
      "assetRole": "输入样例：用户界面菜单声，用来演示流程接收的真实音频来件"
    },
    {
      "id": "n-enrich",
      "label": "补齐信息 · 订单/物流/历史工单",
      "kind": "filter",
      "x": 306,
      "y": 172,
      "params": {
        "strategy": "normalize",
        "timeoutMs": 2500,
        "policy": "fail-closed",
        "templateRef": "workflow/customer-context-v1"
      }
    },
    {
      "id": "n-classify",
      "label": "分诊判定 · 出结论并写明依据",
      "kind": "filter",
      "x": 556,
      "y": 172,
      "params": {
        "strategy": "template",
        "timeoutMs": 1500,
        "policy": "require-human",
        "templateRef": "workflow/ticket-classifier-v1"
      }
    },
    {
      "id": "n-triage",
      "label": "互斥分诊口 · 三条路 + 兜底",
      "kind": "branch",
      "x": 806,
      "y": 172,
      "params": {
        "strategy": "route-by-value",
        "field": "category",
        "operator": "eq",
        "defaultPort": "other",
        "timeoutMs": 500,
        "policy": "fail-closed",
        "templateRef": "workflow/exclusive-triage-v1"
      },
      "assetId": "assets/audio/sfx/freesound-855481.mp3",
      "assetRole": "规则依据：UI 提示音组，用来给分支、复核和合并节点定义可试听的判定基准"
    },
    {
      "id": "n-auto-reply",
      "label": "自助路 · 套话术库回复",
      "kind": "text",
      "x": 1056,
      "y": 172,
      "params": {
        "strategy": "template",
        "timeoutMs": 2000,
        "policy": "fail-open",
        "templateRef": "workflow/self-service-reply-v2"
      }
    },
    {
      "id": "n-queue",
      "label": "人工路 · 按技能组排队",
      "kind": "filter",
      "x": 1056,
      "y": 288,
      "params": {
        "strategy": "queue",
        "timeoutMs": 900000,
        "policy": "continue-with-warning"
      }
    },
    {
      "id": "n-verify",
      "label": "退款路 · 核对金额与凭证",
      "kind": "filter",
      "x": 1056,
      "y": 404
    },
    {
      "id": "n-fallback",
      "label": "兜底 · 三条都不命中转总台",
      "kind": "filter",
      "x": 1056,
      "y": 520
    },
    {
      "id": "n-agent",
      "label": "人工路 · 坐席处理并回访",
      "kind": "filter",
      "x": 1306,
      "y": 172
    },
    {
      "id": "n-approve",
      "label": "退款路 · 审批（超额转人工复核）",
      "kind": "filter",
      "x": 1306,
      "y": 288,
      "params": {
        "strategy": "threshold",
        "field": "refundAmount",
        "operator": "lte",
        "threshold": 200,
        "approvalRequired": true,
        "timeoutMs": 14400000,
        "policy": "require-human",
        "templateRef": "workflow/refund-approval-v1"
      }
    },
    {
      "id": "n-refund",
      "label": "退款路 · 发起退款并留痕",
      "kind": "overlay",
      "x": 1556,
      "y": 172,
      "params": {
        "strategy": "render",
        "timeoutMs": 30000,
        "policy": "record-only",
        "templateRef": "workflow/refund-ledger-v1"
      }
    },
    {
      "id": "n-close",
      "label": "结案登记 · 记走了哪条路",
      "kind": "output",
      "x": 1806,
      "y": 172,
      "params": {
        "strategy": "archive",
        "timeoutMs": 5000,
        "policy": "record-only"
      },
      "assetId": "assets/audio/sfx/freesound-442583.mp3",
      "assetRole": "输出示例：短促欢呼声，用来说明结束或归档节点交付的可播放确认结果"
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": "n-intake",
      "to": "n-enrich",
      "fromPort": "ticket",
      "toPort": "ticket"
    },
    {
      "id": "e1",
      "from": "n-enrich",
      "to": "n-classify",
      "fromPort": "full",
      "toPort": "full"
    },
    {
      "id": "e2",
      "from": "n-classify",
      "to": "n-triage",
      "fromPort": "tagged",
      "toPort": "tagged"
    },
    {
      "id": "e3",
      "from": "n-triage",
      "to": "n-auto-reply",
      "fromPort": "self",
      "toPort": "in"
    },
    {
      "id": "e4",
      "from": "n-triage",
      "to": "n-queue",
      "fromPort": "agent",
      "toPort": "in"
    },
    {
      "id": "e5",
      "from": "n-triage",
      "to": "n-verify",
      "fromPort": "refund",
      "toPort": "in"
    },
    {
      "id": "e6",
      "from": "n-triage",
      "to": "n-fallback",
      "fromPort": "other",
      "toPort": "in"
    },
    {
      "id": "e7",
      "from": "n-auto-reply",
      "to": "n-close",
      "fromPort": "out",
      "toPort": "in-self"
    },
    {
      "id": "e8",
      "from": "n-queue",
      "to": "n-agent",
      "fromPort": "out",
      "toPort": "in"
    },
    {
      "id": "e9",
      "from": "n-agent",
      "to": "n-close",
      "fromPort": "out",
      "toPort": "in-agent"
    },
    {
      "id": "e10",
      "from": "n-verify",
      "to": "n-approve",
      "fromPort": "out",
      "toPort": "in"
    },
    {
      "id": "e11",
      "from": "n-approve",
      "to": "n-refund",
      "fromPort": "out",
      "toPort": "in"
    },
    {
      "id": "e12",
      "from": "n-refund",
      "to": "n-close",
      "fromPort": "out",
      "toPort": "in-refund"
    },
    {
      "id": "e13",
      "from": "n-fallback",
      "to": "n-close",
      "fromPort": "out",
      "toPort": "in-fallback"
    }
  ]
}
