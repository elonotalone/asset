{
  "schema": "oceanleo.workflow-view/v1",
  "note": "站内查看数据逐条投影自 project；params 与 theme 均保留，查看器不得用默认色覆盖调用方合法输入。",
  "project": "oceanleo.video-canvas.v1",
  "theme": {
    "surface": "#17152B",
    "node": "#2A2548",
    "nodeBorder": "#8C7CF0",
    "text": "#F4F0FF",
    "muted": "#B9AEDB",
    "edge": "#8C7CF0",
    "accent": "#E85AAD",
    "warning": "#FF8A65"
  },
  "nodes": [
    {
      "id": "n-draft",
      "label": "草稿 · 作者手上",
      "kind": "source",
      "x": 56,
      "y": 172,
      "assetId": "assets/audio/sfx/freesound-514833.mp3",
      "assetRole": "输入样例：用户界面菜单声，用来演示流程接收的真实音频来件"
    },
    {
      "id": "n-submitted",
      "label": "已送审 · 编辑手上",
      "kind": "filter",
      "x": 306,
      "y": 172,
      "params": {
        "strategy": "queue",
        "timeoutMs": 86400000,
        "policy": "continue-with-warning"
      }
    },
    {
      "id": "n-review",
      "label": "审读判定 · 通过/退改/准撤回",
      "kind": "branch",
      "x": 556,
      "y": 172,
      "params": {
        "strategy": "route-by-value",
        "field": "reviewDecision",
        "operator": "eq",
        "defaultPort": "revise",
        "timeoutMs": 28800000,
        "policy": "require-human",
        "templateRef": "workflow/editorial-review-v1"
      },
      "assetId": "assets/audio/sfx/freesound-855481.mp3",
      "assetRole": "规则依据：UI 提示音组，用来给分支、复核和合并节点定义可试听的判定基准"
    },
    {
      "id": "n-withdrawn",
      "label": "已撤回 · 作者取回",
      "kind": "filter",
      "x": 806,
      "y": 172
    },
    {
      "id": "n-factcheck",
      "label": "校对核红 · 校对手上",
      "kind": "filter",
      "x": 806,
      "y": 288
    },
    {
      "id": "n-check",
      "label": "核红判定 · 清白/带红回退改",
      "kind": "branch",
      "x": 1056,
      "y": 172,
      "params": {
        "strategy": "route-by-value",
        "field": "factCheckDecision",
        "operator": "eq",
        "defaultPort": "red",
        "timeoutMs": 14400000,
        "policy": "fail-closed",
        "templateRef": "workflow/fact-check-v1"
      }
    },
    {
      "id": "n-revising",
      "label": "退改中 · 作者手上（记第几次）",
      "kind": "filter",
      "x": 1306,
      "y": 172,
      "params": {
        "strategy": "retry",
        "maxIterations": 3,
        "retryDelayMs": 0,
        "timeoutMs": 86400000,
        "policy": "escalate"
      }
    },
    {
      "id": "n-escalate",
      "label": "主编裁定 · 打回次数已用尽",
      "kind": "filter",
      "x": 1556,
      "y": 172,
      "params": {
        "strategy": "route-by-value",
        "field": "chiefDecision",
        "operator": "eq",
        "defaultPort": "drop",
        "approvalRequired": true,
        "timeoutMs": 86400000,
        "policy": "require-human",
        "templateRef": "workflow/chief-editor-decision-v1"
      }
    },
    {
      "id": "n-approved",
      "label": "定稿待发 · 等排期",
      "kind": "filter",
      "x": 1806,
      "y": 172
    },
    {
      "id": "n-archive",
      "label": "归档 · 唯一终态（发布/废弃）",
      "kind": "output",
      "x": 2056,
      "y": 172,
      "params": {
        "strategy": "archive",
        "timeoutMs": 5000,
        "policy": "record-only"
      },
      "assetId": "assets/audio/sfx/freesound-442583.mp3",
      "assetRole": "输出示例：短促欢呼声，用来说明结束或归档节点交付的可播放确认结果"
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": "n-draft",
      "to": "n-submitted",
      "fromPort": "submit",
      "toPort": "from-draft"
    },
    {
      "id": "e1",
      "from": "n-submitted",
      "to": "n-review",
      "fromPort": "out",
      "toPort": "in"
    },
    {
      "id": "e2",
      "from": "n-review",
      "to": "n-factcheck",
      "fromPort": "pass",
      "toPort": "in"
    },
    {
      "id": "e3",
      "from": "n-review",
      "to": "n-revising",
      "fromPort": "revise",
      "toPort": "from-review"
    },
    {
      "id": "e4",
      "from": "n-review",
      "to": "n-withdrawn",
      "fromPort": "withdraw",
      "toPort": "in"
    },
    {
      "id": "e5",
      "from": "n-revising",
      "to": "n-submitted",
      "fromPort": "resubmit",
      "toPort": "resubmit",
      "back": true
    },
    {
      "id": "e6",
      "from": "n-withdrawn",
      "to": "n-draft",
      "fromPort": "to-draft",
      "toPort": "back",
      "back": true
    },
    {
      "id": "e7",
      "from": "n-factcheck",
      "to": "n-check",
      "fromPort": "out",
      "toPort": "in"
    },
    {
      "id": "e8",
      "from": "n-check",
      "to": "n-approved",
      "fromPort": "clean",
      "toPort": "from-check"
    },
    {
      "id": "e9",
      "from": "n-check",
      "to": "n-revising",
      "fromPort": "red",
      "toPort": "from-check"
    },
    {
      "id": "e10",
      "from": "n-revising",
      "to": "n-escalate",
      "fromPort": "exhausted",
      "toPort": "in"
    },
    {
      "id": "e11",
      "from": "n-escalate",
      "to": "n-approved",
      "fromPort": "keep",
      "toPort": "from-chief"
    },
    {
      "id": "e12",
      "from": "n-escalate",
      "to": "n-archive",
      "fromPort": "drop",
      "toPort": "in-dropped"
    },
    {
      "id": "e13",
      "from": "n-approved",
      "to": "n-archive",
      "fromPort": "out",
      "toPort": "in-published"
    }
  ]
}
